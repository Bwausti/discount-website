<div class="pdp-trust-section">
  <div class="pdp-trust-grid">
    <div class="pdp-trust-item">
      <span class="pdp-trust-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      </span>
      <span class="pdp-trust-text">Secure checkout</span>
    </div>
    <div class="pdp-trust-item">
      <span class="pdp-trust-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
      </span>
      <span class="pdp-trust-text">{% if product.vendor == 'Helix' %}Free U.S. shipping{% else %}Delivery available{% endif %}</span>
    </div>
    <div class="pdp-trust-item">
      <span class="pdp-trust-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3l7 3v5c0 4.5-2.8 8-7 10-4.2-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
      </span>
      <span class="pdp-trust-text">Brand warranty</span>
    </div>
    <div class="pdp-trust-item">
      <span class="pdp-trust-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 20v-9l8-7 8 7v9"/><path d="M8 20v-6h8v6"/></svg>
      </span>
      <span class="pdp-trust-text">Local showroom help</span>
    </div>
  </div>

  <div class="pdp-financing">
    <p class="pdp-financing-heading">FLEXIBLE FINANCING OPTIONS</p>
    <div class="pdp-financing-logos">
      <div class="pdp-financing-tile">
        <img src="{{ 'sync-logo.svg' | asset_url }}" alt="Synchrony" loading="lazy" width="160" height="35">
      </div>
      <div class="pdp-financing-tile">
        <img src="{{ 'kafene-logo.svg' | asset_url }}" alt="Kafene" loading="lazy" width="160" height="52">
      </div>
      <div class="pdp-financing-tile">
        <img src="{{ 'snapfin-logo.svg' | asset_url }}" alt="Snap Finance" loading="lazy" width="160" height="80">
      </div>
    </div>
    <a href="/pages/financing" class="pdp-financing-btn">Explore financing</a>
  </div>
</div>
