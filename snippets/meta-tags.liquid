{%- liquid
  assign dm_title = page_title | default: shop.name
  assign dm_desc = page_description | default: shop.description | default: shop.name
  assign dm_type = 'website'
  assign dm_image = page_image

  if request.page_type == 'index'
    assign dm_title = 'Discount Mattress | Mattress Store in Bowling Green, KY'
    assign dm_desc = 'Shop Helix, Puffy, Nectar, DreamCloud, Serta, and more online or at Discount Mattress in Bowling Green, Kentucky. Local help, financing, delivery, and nationwide shipping.'
  elsif request.page_type == 'product'
    assign dm_title = product.title | append: ' | Discount Mattress'
    assign dm_type = 'product'
    assign dm_image = product.featured_media.preview_image | default: product.featured_image
    if product.vendor == 'Helix' and product.type == 'Mattress'
      assign dm_desc = 'Shop the ' | append: product.title | append: ' hybrid mattress at Discount Mattress. Compare Core, Luxe, and Elite options, choose cooling upgrades, and get local help in Bowling Green.'
    elsif page_description == blank
      assign dm_desc = product.description | strip_html | strip | truncate: 155
    endif
  elsif request.page_type == 'collection'
    assign dm_title = collection.title | append: ' | Discount Mattress'
    assign dm_desc = collection.description | strip_html | strip | truncate: 155
    if dm_desc == blank
      assign dm_desc = 'Shop ' | append: collection.title | append: ' at Discount Mattress in Bowling Green, Kentucky. Compare options online or get local help in our showrooms.'
    endif
    assign dm_image = collection.image
  elsif request.page_type == 'list-collections'
    assign dm_title = 'Mattress Brands | Discount Mattress Bowling Green'
    assign dm_desc = 'Compare leading mattress brands including Helix, Puffy, Nectar, DreamCloud, Serta, Naturepedic, BedGear, and more.'
  elsif request.page_type == 'page'
    assign dm_title = page.title | append: ' | Discount Mattress'
    if page_description == blank
      assign dm_desc = page.content | strip_html | strip | truncate: 155
    endif
    if page.handle == 'contact'
      assign dm_desc = 'Contact Discount Mattress in Bowling Green, Kentucky for mattress shopping help, financing questions, delivery information, and showroom directions.'
    elsif page.handle == 'locations'
      assign dm_desc = 'Find Discount Mattress showroom locations, phone numbers, current hours, and directions in Bowling Green, Kentucky.'
    elsif page.handle == 'financing'
      assign dm_desc = 'Explore flexible mattress financing options available at Discount Mattress in Bowling Green, Kentucky.'
    endif
  elsif request.page_type == 'article'
    assign dm_title = article.title | append: ' | Discount Mattress'
    assign dm_type = 'article'
    assign dm_image = article.image
    if page_description == blank
      assign dm_desc = article.excerpt_or_content | strip_html | strip | truncate: 155
    endif
  endif
-%}

<title>{{ dm_title | escape }}</title>
<meta name="description" content="{{ dm_desc | strip_html | strip | escape }}">
<link rel="canonical" href="{{ canonical_url }}">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ dm_title | escape }}">
<meta property="og:type" content="{{ dm_type }}">
<meta property="og:description" content="{{ dm_desc | strip_html | strip | escape }}">

{%- if dm_image -%}
  <meta property="og:image" content="https:{{ dm_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ dm_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ dm_title | escape }}">
<meta name="twitter:description" content="{{ dm_desc | strip_html | strip | escape }}">
{%- if dm_image -%}
  <meta name="twitter:image" content="https:{{ dm_image | image_url: width: 1200 }}">
{%- endif -%}
