{% comment %}SEO override snippet{% endcomment %}

{%- liquid
  assign dm_title = page_title | default: shop.name
  assign dm_desc = page_description | default: shop.description | default: shop.name

  assign req_path = request.path | strip

  if req_path == '/' or req_path == '' or request.page_type == 'index'
    assign dm_title = 'Discount Mattress Bowling Green, KY'
    assign dm_desc = 'Shop Helix, Puffy, Nectar, DreamCloud, Serta, and more at Discount Mattress in Bowling Green, KY. Try top mattress brands in-store with local service, financing, and delivery.'

  elsif req_path contains '/collections/all'
    assign dm_title = 'Shop Mattresses and Bedding in Bowling Green, KY'
    assign dm_desc = 'Compare mattresses, pillows, bedding, and accessories from top brands at Discount Mattress. Visit our Bowling Green showrooms for local help, financing, and delivery options.'

  elsif req_path contains '/collections/pressure-relief'
    assign dm_title = 'Pressure Relief Mattresses in Bowling Green, KY'
    assign dm_desc = 'Find pressure-relieving mattresses for side sleepers, sore joints, and better comfort. Try foam and hybrid options in-store at Discount Mattress in Bowling Green, KY.'

  elsif req_path contains '/collections/puffy'
    assign dm_title = 'Puffy Mattresses in Bowling Green, KY'
    assign dm_desc = 'Shop Puffy mattresses at Discount Mattress in Bowling Green, KY. Try Puffy Cloud, Lux, and Royal Hybrid in person at our showroom.'

  elsif req_path contains '/collections/helix'
    assign dm_title = 'Helix Mattresses in Bowling Green, KY'
    assign dm_desc = 'Shop Helix mattresses at Discount Mattress in Bowling Green, KY. Try personalized Sleepquiz recommendations in person.'

  elsif req_path contains '/collections/cooling'
    assign dm_title = 'Cooling Mattresses in Bowling Green, KY'
    assign dm_desc = 'If you sleep hot, cooling comfort matters. Compare mattresses with breathable covers, gel-infused foams, and hybrid airflow at Discount Mattress in Bowling Green, KY.'

  elsif req_path contains '/collections/luxury'
    assign dm_title = 'Luxury Mattresses in Bowling Green, KY'
    assign dm_desc = 'Looking for a more elevated sleep experience? Our luxury-feel mattresses feature premium materials and enhanced support systems.'

  elsif req_path contains '/collections/organic'
    assign dm_title = 'Organic Mattresses in Bowling Green, KY'
    assign dm_desc = 'Shop mattresses made with organic cotton, wool, and latex at Discount Mattress in Bowling Green, KY.'

  elsif req_path contains '/collections' or request.page_type == 'list-collections'
    assign dm_title = 'Mattress Brands in Bowling Green, KY'
    assign dm_desc = 'Browse premium mattress brands available at Discount Mattress in Bowling Green, KY, including Helix, Puffy, Nectar, DreamCloud, Serta, Naturepedic, BedGear, and more.'

  elsif request.page_type == 'page'
    if page.handle == 'contact'
      assign dm_title = 'Contact Discount Mattress in Bowling Green, KY'
      assign dm_desc = 'Call or visit Discount Mattress in Bowling Green, KY. Get help choosing the right mattress, ask about financing, or find directions to our Campbell Lane and Russellville Road locations.'
    elsif page.handle == 'locations'
      assign dm_title = 'Discount Mattress Locations in Bowling Green, KY'
      assign dm_desc = 'Visit Discount Mattress in Bowling Green, KY. Find showroom addresses, phone numbers, hours, directions, and local mattress shopping help.'
    elsif page.handle == 'faq'
      assign dm_title = 'Mattress Store FAQ | Discount Mattress'
      assign dm_desc = 'Get answers about mattress brands, financing, delivery, pickup, returns, showroom visits, and shopping at Discount Mattress in Bowling Green, KY.'
    elsif page.handle == 'financing'
      assign dm_title = 'Mattress Financing in Bowling Green, KY'
      assign dm_desc = 'Learn about mattress financing options at Discount Mattress in Bowling Green, KY, including flexible payment options through trusted financing partners.'
    endif
  endif
-%}

<meta property="og:title" content="{{ dm_title | escape }}">
<meta name="twitter:title" content="{{ dm_title | escape }}">
<title>{{ dm_title }}</title>
{% comment %}viewport meta goes here via section injection{% endcomment %}
