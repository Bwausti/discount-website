<section class="dm-cart-assurance" aria-labelledby="dm-cart-assurance-title">
  <div class="dm-cart-assurance__inner">
    <div>
      <p class="dm-cart-assurance__eyebrow">Before checkout</p>
      <h2 id="dm-cart-assurance-title">Clear next steps for your order</h2>
    </div>
    <ul>
      <li><strong>Availability confirmation:</strong> We confirm the selected model and size before capturing payment and scheduling fulfillment.</li>
      <li><strong>Free Nationwide Delivery</strong></li>
      <li><strong>Need help?</strong> Call <a href="tel:12704951603">(270) 495-1603</a> before ordering.</li>
    </ul>
  </div>
</section>

{% stylesheet %}
  .dm-cart-assurance { padding: 32px 20px 0; }
  .dm-cart-assurance__inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: minmax(240px,.75fr) 1.25fr; gap: 32px; align-items: center; padding: 24px 28px; border: 1px solid #dbe3ec; border-radius: 14px; background: #f8fafc; }
  .dm-cart-assurance__eyebrow { margin: 0 0 5px; color: #cf2333; font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .dm-cart-assurance h2 { margin: 0; color: #162b49; font-size: clamp(22px, 3vw, 30px); line-height: 1.08; }
  .dm-cart-assurance ul { display: grid; gap: 8px; margin: 0; padding-left: 20px; color: #475569; font-size: 13px; line-height: 1.55; }
  .dm-cart-assurance a { color: #162b49; font-weight: 800; }
  @media (max-width: 749px) {
    .dm-cart-assurance { padding: 20px 16px 0; }
    .dm-cart-assurance__inner { grid-template-columns: 1fr; gap: 18px; padding: 22px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart assurance",
  "settings": []
}
{% endschema %}
