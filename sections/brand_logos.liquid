      </a>
      <a href="{{ routes.collections_url }}/serta" class="brand-secondary-card">
        <img src="{{ 'logo-serta.svg' | asset_url }}" alt="Serta" class="brand-secondary-logo" style="max-height: 48px;" width="220" height="80" loading="lazy">
      </a>
      <a href="{{ routes.collections_url }}/jamison" class="brand-secondary-card">
        <img src="{{ 'logo-jamison.png' | asset_url }}" alt="Jamison" class="brand-secondary-logo" style="max-height: 48px;" width="220" height="80" loading="lazy">
      </a>
      <a href="{{ routes.collections_url }}/naturepedic" class="brand-secondary-card" style="display: flex; flex-direction: column; gap: 2px;">
        <span style="font-size: 15px; font-weight: 800; color: #2d6a4f; letter-spacing: -0.01em;">Naturepedic</span>
        <span style="font-size: 10px; font-weight: 600; color: #6b7280; letter-spacing: 0.05em;">ORGANIC</span>
