      <a href="{{ routes.collections_url }}/posh-and-lavish" class="brand-secondary-card" style="display: flex; flex-direction: column; gap: 2px;">
        <span style="font-size: 14px; font-weight: 800; color: #7c3a50; letter-spacing: -0.01em;">Posh & Lavish</span>
        <span style="font-size: 10px; font-weight: 600; color: #6b7280; letter-spacing: 0.05em;">LUXURY</span>
      </a>
    </div>

    <!-- View all link -->
    <div style="text-align: center; margin-top: 20px;">
      <a href="{{ routes.collections_url }}" style="display: inline-block; background: #162b49; color: white; padding: 14px 40px; border-radius: 8px; text-decoration: none; font-weight: 800; font-size: 15px;">All Brands</a>
    </div>

  </div>
</section>
