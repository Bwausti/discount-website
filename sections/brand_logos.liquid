      </a>
      <a href="{{ routes.collections_url }}/bedgear" class="brand-secondary-card">
        <img src="{{ 'logo-bedgear.png' | asset_url }}" alt="Bedgear" class="brand-secondary-logo" width="220" height="80" loading="lazy">
