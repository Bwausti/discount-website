  <!-- ELEGANT CTA -->
  <section style="background: linear-gradient(135deg, #2d1b2e 0%, #4a2840 50%, #2d1b2e 100%);padding:64px 24px;text-align:center;">
    <div style="max-width:700px;margin:0 auto;">
      <p style="color:#d4a59a;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.22em;margin:0 0 12px;">Experience the difference</p>
      <h2 style="color:white;font-size:clamp(28px,3vw,38px);font-weight:900;margin:0 0 12px;letter-spacing:-0.02em;">Enhanced sleep quality. Lavish comfort.</h2>
      <p style="color:rgba(255,255,255,0.85);font-size:16px;line-height:1.6;margin:0 0 28px;">The Providence True Pillow Top is designed for those who refuse to compromise on their rest. Natural materials meet expert craftsmanship for a cloud-like sensation that cradles your body while maintaining essential spinal alignment.</p>
      <a href="https://maps.google.com/?q=1555+Campbell+Ln+Bowling+Green+KY+42104" style="display:inline-block;background:#d4a59a;color:white;padding:14px 32px;border-radius:6px;text-decoration:none;font-weight:800;font-size:14px;margin-right:12px;">📍 Get directions</a>
      <a href="tel:+12704951603" style="display:inline-block;border:2px solid rgba(255,255,255,0.3);color:white;padding:14px 32px;border-radius:6px;text-decoration:none;font-weight:800;font-size:14px;">📞 (270) 495-1603</a>
