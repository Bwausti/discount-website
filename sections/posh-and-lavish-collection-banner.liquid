  <!-- HIGHLIGHTS -->
  <section class="posh-highlights">
    <div class="posh-highlights__inner">
      <span class="posh-highlight-pill">✦ Premium quilted covers</span>
      <span class="posh-highlight-pill">✦ Multi-layer foam cores</span>
      <span class="posh-highlight-pill">✦ Elegant fabric finishes</span>
      <span class="posh-highlight-pill">✦ True pillow top options</span>
      <span class="posh-highlight-pill">✦ Medium-plush to plush feels</span>
      <span class="posh-highlight-pill">✦ Showroom-inspectable</span>
