{{ 'brand-nav.css' | asset_url | stylesheet_tag }}

<nav class="brand-nav" role="navigation" aria-label="Brand navigation">
  <div class="brand-nav__container">
    <div class="brand-nav__wrapper">
      <button class="brand-nav__toggle" aria-expanded="false" aria-label="Toggle brand navigation">
        <span class="brand-nav__toggle-text">Browse</span>
        <svg class="brand-nav__chevron" width="12" height="8" viewBox="0 0 12 8" fill="none">
          <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <ul class="brand-nav__list">

        {% comment %}── Shop All ──{% endcomment %}
        <li class="brand-nav__item">
          <a href="{{ routes.collections_url }}/all" class="brand-nav__link">Shop All</a>
        </li>

        {% comment %}── Top Brands (dropdown) ──{% endcomment %}
        <li class="brand-nav__item brand-nav__item--dropdown">
          <button class="brand-nav__link brand-nav__dropdown-toggle" aria-expanded="false" aria-haspopup="true">
            Top Brands
            <svg class="brand-nav__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="brand-nav__dropdown">
            <li><a href="{{ routes.collections_url }}/helix" class="brand-nav__dropdown-link">Helix</a></li>
            <li><a href="{{ routes.collections_url }}/nectar" class="brand-nav__dropdown-link">Nectar</a></li>
            <li><a href="{{ routes.collections_url }}/puffy" class="brand-nav__dropdown-link">Puffy</a></li>
            <li><a href="{{ routes.collections_url }}/dreamcloud" class="brand-nav__dropdown-link">DreamCloud</a></li>
            <li><a href="{{ routes.collections_url }}/naturepedic" class="brand-nav__dropdown-link">Naturepedic</a></li>
          </ul>
        </li>

        {% comment %}── More Brands (dropdown) ──{% endcomment %}
        <li class="brand-nav__item brand-nav__item--dropdown">
          <button class="brand-nav__link brand-nav__dropdown-toggle" aria-expanded="false" aria-haspopup="true">
            More Brands
            <svg class="brand-nav__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="brand-nav__dropdown">
            <li><a href="{{ routes.collections_url }}/bedgear" class="brand-nav__dropdown-link">BedGear</a></li>
            <li><a href="{{ routes.collections_url }}/bedtech" class="brand-nav__dropdown-link">BedTech</a></li>
            <li><a href="{{ routes.collections_url }}/serta" class="brand-nav__dropdown-link">Serta</a></li>
            <li><a href="{{ routes.collections_url }}/jamison" class="brand-nav__dropdown-link">Jamison</a></li>
            <li><a href="{{ routes.collections_url }}/pranasleep" class="brand-nav__dropdown-link">PranaSleep</a></li>
            <li><a href="{{ routes.collections_url }}/posh-and-lavish" class="brand-nav__dropdown-link">Posh and Lavish</a></li>
          </ul>
        </li>

        {% comment %}── Financing ──{% endcomment %}
        <li class="brand-nav__item">
          <a href="/pages/financing" class="brand-nav__link">Financing</a>
        </li>

        {% comment %}── Contact ──{% endcomment %}
        <li class="brand-nav__item">
          <a href="/pages/contact" class="brand-nav__link">Contact</a>
        </li>

        {% comment %}── FAQ ──{% endcomment %}
        <li class="brand-nav__item">
          <a href="/pages/faq" class="brand-nav__link">FAQ</a>
        </li>

      </ul>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Mobile toggle
    const toggle = document.querySelector('.brand-nav__toggle');
    const list = document.querySelector('.brand-nav__list');
    if (toggle && list) {
      toggle.addEventListener('click', function() {
        const expanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', !expanded);
        list.classList.toggle('brand-nav__list--open');
      });
    }

    // Desktop dropdown toggles (click on mobile, hover on desktop)
    const dropdownToggles = document.querySelectorAll('.brand-nav__dropdown-toggle');
    dropdownToggles.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        // Only toggle on click for mobile (or keyboard)
        const parent = this.closest('.brand-nav__item--dropdown');
        const isOpen = parent.classList.toggle('brand-nav__dropdown--open');
        this.setAttribute('aria-expanded', isOpen);
      });

      // Close on Escape
      btn.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          const parent = this.closest('.brand-nav__item--dropdown');
          parent.classList.remove('brand-nav__dropdown--open');
          this.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.brand-nav__item--dropdown')) {
        document.querySelectorAll('.brand-nav__item--dropdown.brand-nav__dropdown--open').forEach(function(el) {
          el.classList.remove('brand-nav__dropdown--open');
          el.querySelector('.brand-nav__dropdown-toggle').setAttribute('aria-expanded', 'false');
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Brand Navigation",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Brand Navigation"
    }
  ]
}
{% endschema %}
