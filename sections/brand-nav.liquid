{{ 'brand-nav.css' | asset_url | stylesheet_tag }}

<nav class="brand-nav" role="navigation" aria-label="Brand navigation">
  <div class="brand-nav__container">
    <div class="brand-nav__wrapper">
      <button class="brand-nav__toggle" aria-expanded="false" aria-label="Toggle brand navigation">
        <span class="brand-nav__toggle-text">Browse</span>
        <svg class="brand-nav__chevron" width="12" height="8" viewBox="0 0 12 8" fill="none">
          <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <ul class="brand-nav__list">
        {%- assign nav_items = "Shop All|Helix|Puffy|Nectar|DreamCloud|BedGear|Naturepedic|Serta|BedTech|Jamison|PranaSleep|Posh and Lavish|Financing|Contact|FAQ" | split: "|" -%}
        {%- assign nav_urls = "/collections/all|/collections/helix|/collections/puffy|/collections/nectar|/collections/dreamcloud|/collections/bedgear|/collections/naturepedic|/collections/serta|/collections/bedtech|/collections/jamison|/collections/pranasleep|/collections/posh-and-lavish|/pages/financing|/pages/contact|/pages/faq" | split: "|" -%}
        {%- for item in nav_items -%}
          {%- assign i = forloop.index0 -%}
          <li class="brand-nav__item">
            <a href="{{ nav_urls[i] }}" class="brand-nav__link">
              {{ item }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.querySelector('.brand-nav__toggle');
    const list = document.querySelector('.brand-nav__list');
    if (toggle && list) {
      toggle.addEventListener('click', function() {
        const expanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', !expanded);
        list.classList.toggle('brand-nav__list--open');
      });
    }
  });
</script>

{% schema %}
{
  "name": "Brand Navigation",
  "settings": [],
  "presets": [
    {
      "name": "Brand Navigation"
    }
  ]
}
{% endschema %}
