{% comment %}
  helix-product-addons.liquid
  Shows tier-specific Helix add-on options on product pages
  Based on Helix Sleep's official tier structure (2025):
  - Core: ErgoAlign Layer optional, GlacioTex Cooling Pillow Top optional
  - Luxe: ErgoAlign Layer optional (zoned lumbar foam, integrated into comfort layer)
  - Elite: ErgoAlign Layer STANDARD (built-in), GlacioTex + CoolForce standard

  The ErgoAlign Layer is NEVER sold as a standalone product —
  it is an integrated comfort upgrade added during mattress purchase.
{% endcomment %}

{% assign product_title = closest.product.title | downcase %}
{% assign is_helix_product = false %}
{% assign is_core = false %}
{% assign is_luxe = false %}
{% assign is_elite = false %}
{% if closest.product.vendor == "Helix" %}
  {% assign is_helix_product = true %}
  {% if product_title contains "elite" %}
    {% assign is_elite = true %}
  {% elsif product_title contains "luxe" %}
    {% assign is_luxe = true %}
  {% else %}
    {% assign is_core = true %}
  {% endif %}
{% endif %}

{% if is_helix_product %}

<style>
  .helix-addons {
    background: #f7f6f1;
    border-top: 1px solid #e2e8f0;
    padding: 48px 24px;
    margin-top: 0;
  }
  .helix-addons__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .helix-addons__header {
    margin-bottom: 32px;
  }
  .helix-addons__label {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #cf2333;
    margin-bottom: 8px;
  }
  .helix-addons__title {
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin: 0 0 8px 0;
  }
  .helix-addons__sub {
    font-size: 14px;
    color: #64748b;
    margin: 0;
  }
  .helix-addons__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .helix-addon-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .helix-addon-card:hover {
    border-color: #f2b705;
    box-shadow: 0 6px 24px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }
  .helix-addon-card__tier-badge {
    display: inline-block;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 3px 10px;
    border-radius: 4px;
    background: #f7f6f1;
    color: #334155;
    width: fit-content;
  }
  .helix-addon-card__tier-badge.luxe { background: #fef9e7; color: #92400e; }
  .helix-addon-card__tier-badge.elite { background: #eff6ff; color: #1e40af; }
  .helix-addon-card__name {
    font-size: 16px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
  }
  .helix-addon-card__desc {
    font-size: 13px;
    color: #64748b;
    line-height: 1.55;
    margin: 0;
    flex-grow: 1;
  }
  .helix-addon-card__price {
    font-size: 15px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }
  .helix-addon-card__cta {
    font-size: 12px;
    font-weight: 800;
    color: #cf2333;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
  }
  .helix-addon-card:hover .helix-addon-card__cta { gap: 8px; }
</style>

<div class="helix-addons">
  <div class="helix-addons__inner">

    <!-- Header -->
    <div class="helix-addons__header">
      <p class="helix-addons__label">Layer &amp; Cooling Options</p>
      {% if is_elite %}
        <h2 class="helix-addons__title">Elite — Premium Built-in</h2>
        <p class="helix-addons__sub">The Elite comes fully equipped with GlacioTex™ cooling, CoolForce™ system, and the ErgoAlign Layer as standard.</p>
      {% elsif is_luxe %}
        <h2 class="helix-addons__title">Luxe — Optional Upgrades</h2>
        <p class="helix-addons__sub">Add the ErgoAlign Layer for zoned lumbar support, or upgrade to a GlacioTex™ cooling pillow top.</p>
      {% else %}
        <h2 class="helix-addons__title">Core — Optional Upgrades</h2>
        <p class="helix-addons__sub">Upgrade your Core mattress with the ErgoAlign Layer for targeted support or a GlacioTex™ cooling pillow top.</p>
      {% endif %}
    </div>

    <!-- Add-on cards -->
    <div class="helix-addons__grid">

      {% if is_elite %}
        {% comment %} Elite: Everything is standard {% endcomment %}
        <div class="helix-addon-card" style="cursor:default;">
          <span class="helix-addon-card__tier-badge elite">Standard</span>
          <h3 class="helix-addon-card__name">ErgoAlign™ Layer</h3>
          <p class="helix-addon-card__desc">Zoned lumbar support layer integrated into the Elite's comfort system. Ultra-dense foam segment under the midsection provides targeted support and spinal alignment.</p>
          <p class="helix-addon-card__price">Included</p>
        </div>

        <div class="helix-addon-card" style="cursor:default;">
          <span class="helix-addon-card__tier-badge elite">Standard</span>
          <h3 class="helix-addon-card__name">GlacioTex™ + CoolForce™</h3>
          <p class="helix-addon-card__desc">Cool-to-touch cover with phase-change materials plus active cooling layer beneath for temperature regulation.</p>
          <p class="helix-addon-card__price">Included</p>
        </div>

      {% elsif is_luxe %}
        {% comment %} Luxe: ErgoAlign Layer is optional, Cooling Pillow Top is optional {% endcomment %}
        <div class="helix-addon-card" style="cursor:default;">
          <span class="helix-addon-card__tier-badge luxe">Optional Upgrade</span>
          <h3 class="helix-addon-card__name">ErgoAlign™ Layer</h3>
          <p class="helix-addon-card__desc">A zoned foam layer integrated into the Luxe comfort system. Ultra-dense foam beneath your midsection provides targeted lumbar support and spinal alignment. Available as an upgrade when purchased with your Luxe mattress.</p>
          <p class="helix-addon-card__price">Add $187</p>
          <p class="helix-addon-card__cta">Ask in store →</p>
        </div>

        <div class="helix-addon-card" style="cursor:default;">
          <span class="helix-addon-card__tier-badge luxe">Optional Upgrade</span>
          <h3 class="helix-addon-card__name">GlacioTex™ Cooling Pillow Top</h3>
          <p class="helix-addon-card__desc">Upgrade your Luxe cover to GlacioTex™ — a cool-to-touch fabric that pulls heat away from your body for a cooler sleep surface.</p>
          <p class="helix-addon-card__price">Ask for pricing</p>
          <p class="helix-addon-card__cta">Ask in store →</p>
        </div>

      {% else %}
        {% comment %} Core: Both ErgoAlign Layer and GlacioTex are optional (2025 update) {% endcomment %}
        <div class="helix-addon-card" style="cursor:default;">
          <span class="helix-addon-card__tier-badge">Optional Upgrade</span>
          <h3 class="helix-addon-card__name">ErgoAlign™ Layer</h3>
          <p class="helix-addon-card__desc">Add zoned lumbar support to your Core mattress. An ultra-dense foam segment under your midsection provides targeted support where you need it most. Integrated into the comfort layer.</p>
          <p class="helix-addon-card__price">Add $187</p>
          <p class="helix-addon-card__cta">Ask in store →</p>
        </div>

        <div class="helix-addon-card" style="cursor:default;">
          <span class="helix-addon-card__tier-badge">Optional Upgrade</span>
          <h3 class="helix-addon-card__name">GlacioTex™ Cooling Pillow Top</h3>
          <p class="helix-addon-card__desc">Upgrade your Core cover to GlacioTex™ for a cooler sleep surface. Phase-change fabric pulls heat away from your body throughout the night.</p>
          <p class="helix-addon-card__price">Add $187</p>
          <p class="helix-addon-card__cta">Ask in store →</p>
        </div>
      {% endif %}

    </div>
  </div>
</div>

{% endif %}

{% schema %}
{
  "name": "Helix Product Add-ons",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": []
}
{% endschema %}
