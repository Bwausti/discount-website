<!-- Section: service_section -->
<style>
  .ss-section {
    padding: 60px 20px;
    background: #f7f6f1;
  }

  .ss-container {
    max-width: 1100px;
    margin: 0 auto;
    min-width: 0;
  }

  .ss-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .ss-label {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #cf2333;
    margin: 0 0 8px 0;
  }

  .ss-heading {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 800;
    color: #162b49;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .ss-subheading {
    color: #4a5568;
    font-size: 15px;
    margin: 10px auto 0;
    max-width: 560px;
    line-height: 1.6;
  }

  /* Photo gallery */
  .ss-photo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 40px;
  }

  .ss-photo {
    aspect-ratio: 1/1;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.10);
  }

  .ss-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Two-column layout */
  .ss-main-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
    align-items: start;
  }

  .ss-main-grid > *,
  .ss-bullet > div:last-child {
    min-width: 0;
  }

  /* Stats box */
  .ss-stats {
    background: #162b49;
    border-radius: 10px;
    padding: 28px;
    box-shadow: 0 4px 16px rgba(22,43,73,0.15);
  }

  .ss-stat-item {
    text-align: center;
    padding: 0;
  }

  .ss-stat-item + .ss-stat-item {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 20px;
    margin-top: 20px;
  }

  .ss-stat-number {
    font-size: 32px;
    font-weight: 800;
    color: #f2b705;
    margin: 0;
    line-height: 1;
  }

  .ss-stat-label {
    font-size: 11px;
    font-weight: 700;
    color: rgba(255,255,255,0.75);
    margin: 4px 0 0 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Service bullets */
  .ss-bullets {
    display: grid;
    gap: 14px;
  }

  .ss-bullet {
    display: flex;
    gap: 14px;
    align-items: start;
    background: white;
    padding: 18px 20px;
    border-radius: 10px;
    border: 1px solid #e8e4dc;
  }

  .ss-bullet-icon {
    width: 38px;
    height: 38px;
    min-width: 38px;
    background: #f7f6f1;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }

  .ss-bullet-title {
    font-size: 15px;
    font-weight: 800;
    color: #162b49;
    margin: 0 0 4px 0;
  }

  .ss-bullet-desc {
    color: #4a5568;
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
  }
  .ss-price-match-link {
    color: #cf2333;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }
  .ss-price-match-link:hover {
    color: #b81e2c;
  }

  /* CTA buttons */
  .ss-ctas {
    display: flex;
    gap: 12px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .ss-btn-primary {
    display: inline-block;
    background: #162b49;
    color: white;
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
  }

  .ss-btn-secondary {
    display: inline-block;
    border: 1px solid #dedbd2;
    color: #162b49;
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .ss-section {
      padding: 48px 16px;
    }

    .ss-header {
      margin-bottom: 32px;
    }

    /* Photo grid: show only first image, larger */
    .ss-photo-grid {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: 32px;
    }

    .ss-photo:nth-child(n+2) {
      display: none;
    }

    .ss-photo {
      aspect-ratio: 16/9;
      border-radius: 12px;
    }

    /* Stack main grid */
    .ss-main-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ss-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      padding: 24px 20px;
      width: 100%;
      min-width: 0;
      box-sizing: border-box;
    }

    .ss-stat-item {
      text-align: center;
    }

    .ss-stat-item + .ss-stat-item {
      border-top: none;
      border-left: 1px solid rgba(255,255,255,0.1);
      padding-top: 0;
      padding-left: 16px;
      margin-top: 0;
      margin-left: 16px;
    }

    .ss-stat-number {
      font-size: 26px;
    }

    .ss-bullet {
      padding: 16px 18px;
      min-width: 0;
      box-sizing: border-box;
    }

    .ss-ctas {
      flex-direction: column;
    }

    .ss-btn-primary,
    .ss-btn-secondary {
      text-align: center;
      width: 100%;
      box-sizing: border-box;
    }
  }

  @media (max-width: 420px) {
    .ss-stats {
      grid-template-columns: 1fr;
      padding: 20px;
    }

    .ss-stat-item + .ss-stat-item {
      border-top: 1px solid rgba(255,255,255,0.1);
      border-left: 0;
      padding-top: 14px;
      padding-left: 0;
      margin-top: 14px;
      margin-left: 0;
    }

    .ss-bullet {
      gap: 12px;
      padding: 14px;
    }
  }

  /* Tablet */
  @media (min-width: 769px) and (max-width: 1024px) {
    .ss-photo-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ss-photo:nth-child(n+3) {
      display: none;
    }

    .ss-main-grid {
      grid-template-columns: 1fr 1.5fr;
      gap: 32px;
    }
  }
</style>

