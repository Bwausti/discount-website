{%- comment -%}
  Utility bar — phone, hours, directions above main nav
  Settings allow full editing via Shopify theme editor
{%- endcomment -%}
{%- assign mattress_shop_url = routes.collections_url -%}
{%- if section.settings.enable_utility_bar -%}
<div class="utility-bar" role="region" aria-label="Store information">
  <div class="utility-bar__inner">
    <span class="utility-bar__text">{{ section.settings.location_text }}</span>
    <span class="utility-bar__separator" aria-hidden="true">•</span>
    <span class="utility-bar__text">{{ section.settings.hours_text }}</span>
    {%- if section.settings.phone_number != blank -%}
    <span class="utility-bar__separator" aria-hidden="true">•</span>
    <span class="utility-bar__text">{{ section.settings.phone_label }}
      <a href="tel:{{ section.settings.phone_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}"
         class="utility-bar__link">{{ section.settings.phone_display }}</a>
    </span>
    {%- endif -%}
    <span class="utility-bar__actions">
      {%- if section.settings.enable_call_button -%}
      <a href="tel:{{ section.settings.phone_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}"
         class="utility-bar__btn"
         aria-label="Call us at {{ section.settings.phone_display }}">{{ section.settings.call_label }}</a>
      {%- endif -%}
      {%- if section.settings.directions_url != blank -%}
      <a href="{{ section.settings.directions_url }}"
         class="utility-bar__btn"
         target="_blank"
         rel="noopener"
         aria-label="Get directions to our store">{{ section.settings.directions_label }}</a>
      {%- endif -%}
    </span>
  </div>
</div>
{%- endif -%}

{% comment %}
  Unified Header — one row, all navigation merged
  Dark navy (#162b49) + gold accent (#f2b705) + Inter font
{% endcomment %}

<div class="header-wrapper">
  <header class="header">
    <div class="header__container">

      {% comment %} Logo (left) {% endcomment %}
      <div class="header__logo">
        {% if settings.logo != blank %}
          <a href="{{ routes.root_url }}" class="header__logo-link">
            <img
              src="{{ settings.logo | image_url: width: 200 }}"
              alt="{{ settings.logo.alt | default: shop.name }}"
              width="{{ settings.logo.width }}"
              height="{{ settings.logo.height }}"
              class="header__logo-image"
            >
          </a>
        {% else %}
          <a href="{{ routes.root_url }}" class="header__logo-text">
            {{ shop.name }}
          </a>
        {% endif %}
      </div>

      {% comment %} Main Navigation (center) {% endcomment %}
      <nav class="header__nav" aria-label="Main navigation">
        <ul class="header__nav-list">

          {% if section.settings.menu != blank %}
            {%- assign dm_menu_has_about = false -%}
            {% for link in linklists[section.settings.menu].links %}
              {%- if link.url contains '/pages/about-us' -%}
                {%- assign dm_menu_has_about = true -%}
              {%- endif -%}
              <li class="header__nav-item">
                {%- liquid
                  assign link_href = link.url
                  if link.title == 'Shop Mattresses' or link.title == 'Catalog'
                    assign link_href = mattress_shop_url
                  endif
                -%}
                <a href="{{ link_href }}" class="header__nav-link{% if link.active %} is-active{% endif %}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
            {%- unless dm_menu_has_about -%}
              <li class="header__nav-item"><a href="{{ routes.root_url }}pages/about-us" class="header__nav-link">About</a></li>
            {%- endunless -%}
          {% endif %}

          <li class="header__nav-item header__nav-item--dropdown">
            <button class="header__nav-link header__nav-dropdown-toggle" aria-expanded="false" aria-haspopup="true" type="button">
              Top Brands
              <svg class="header__nav-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <ul class="header__nav-dropdown">
              <li><a href="{{ routes.collections_url }}/helix" class="header__nav-dropdown-link">Helix</a></li>
              <li><a href="{{ routes.collections_url }}/nectar" class="header__nav-dropdown-link">Nectar</a></li>
              <li><a href="{{ routes.collections_url }}/puffy" class="header__nav-dropdown-link">Puffy</a></li>
              <li><a href="{{ routes.collections_url }}/dreamcloud" class="header__nav-dropdown-link">DreamCloud</a></li>
              <li><a href="{{ routes.collections_url }}/naturepedic" class="header__nav-dropdown-link">Naturepedic</a></li>
            </ul>
          </li>

          <li class="header__nav-item header__nav-item--dropdown">
            <button class="header__nav-link header__nav-dropdown-toggle" aria-expanded="false" aria-haspopup="true" type="button">
              More Brands
              <svg class="header__nav-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <ul class="header__nav-dropdown">
              <li><a href="{{ routes.collections_url }}/bedgear" class="header__nav-dropdown-link">BedGear</a></li>
              <li><a href="{{ routes.collections_url }}/bedtech" class="header__nav-dropdown-link">BedTech</a></li>
              <li><a href="{{ routes.collections_url }}/jamison" class="header__nav-dropdown-link">Jamison</a></li>
              <li><a href="{{ routes.collections_url }}/pranasleep" class="header__nav-dropdown-link">PranaSleep</a></li>
              <li><a href="{{ routes.collections_url }}/posh-and-lavish" class="header__nav-dropdown-link">Posh and Lavish</a></li>
            </ul>
          </li>

        </ul>
      </nav>

      {% comment %} Cart only (right) {% endcomment %}
      <div class="header__actions">
        <button
          class="header__menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
          aria-label="Open menu"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <span>Menu</span>
        </button>
        <button class="header__cart-btn" aria-label="Open cart ({{ cart.item_count }} items)" type="button" onclick="document.querySelector('cart-drawer-component')?.openDrawer()">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3" d="M3.392 6.875h13.216v8.016c0 .567-.224 1.112-.624 1.513-.4.402-.941.627-1.506.627H5.522a2.13 2.13 0 0 1-1.506-.627 2.15 2.15 0 0 1-.624-1.513zM8.818 2.969h2.333c.618 0 1.211.247 1.649.686a2.35 2.35 0 0 1 .683 1.658v1.562H6.486V5.313c0-.622.246-1.218.683-1.658a2.33 2.33 0 0 1 1.65-.686"/>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="header__cart-badge">{{ cart.item_count }}</span>
          {% endif %}
        </button>
      </div>

    </div>
  </header>
</div>

<div class="mobile-menu-overlay" data-mobile-menu-overlay hidden>
  <nav class="mobile-menu-panel" id="mobile-menu-panel" aria-label="Mobile navigation">
    <div class="mobile-menu-panel__header">
      <strong>Menu</strong>
      <button type="button" class="mobile-menu-panel__close" data-mobile-menu-close aria-label="Close menu">&times;</button>
    </div>
    <a href="{{ mattress_shop_url }}">Shop Mattresses</a>
    <a href="{{ routes.search_url }}">Search</a>
    <a href="{{ routes.root_url }}pages/locations">Locations</a>
    <a href="{{ routes.root_url }}pages/financing">Financing</a>
    <a href="{{ routes.root_url }}pages/about-us">About</a>
    <a href="{{ routes.root_url }}pages/faq">FAQ</a>
    <a href="{{ routes.root_url }}pages/contact">Contact</a>
    <a href="tel:12704951603">Call (270) 495-1603</a>
    <div class="mobile-menu-panel__label">Brands</div>
    <div class="mobile-menu-panel__brands">
      <a href="{{ routes.collections_url }}/helix">Helix</a>
      <a href="{{ routes.collections_url }}/nectar">Nectar</a>
      <a href="{{ routes.collections_url }}/puffy">Puffy</a>
      <a href="{{ routes.collections_url }}/dreamcloud">DreamCloud</a>
      <a href="{{ routes.collections_url }}">All brands</a>
    </div>
    <button class="mobile-menu-panel__cart" onclick="document.querySelector('cart-drawer-component')?.openDrawer()" type="button">
      View Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
    </button>
  </nav>
</div>

{% comment %} Mobile Bottom Navigation {% endcomment %}
<ul class="mobile-nav" id="mobile-nav" role="list">
  <li class="mobile-nav__item">
    <a href="{{ routes.root_url }}" class="mobile-nav__link{% if request.path == '/' %} is-active{% endif %}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      Home
    </a>
  </li>
  <li class="mobile-nav__item">
    <a href="tel:12704951603" class="mobile-nav__link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      Call
    </a>
  </li>
  <li class="mobile-nav__item">
    <a href="{{ routes.collections_url }}" class="mobile-nav__link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7"/>
        <rect x="14" y="3" width="7" height="7"/>
        <rect x="14" y="14" width="7" height="7"/>
        <rect x="3" y="14" width="7" height="7"/>
      </svg>
      Shop
    </a>
  </li>
  <li class="mobile-nav__item mobile-nav__item--cart">
    <button class="mobile-nav__link" onclick="document.querySelector('cart-drawer-component')?.openDrawer()" type="button" aria-label="Open cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
      Cart
      {% if cart.item_count > 0 %}
        <span class="mobile-nav__cart-badge">{{ cart.item_count }}</span>
      {% endif %}
    </button>
  </li>
</ul>

<style>
  :root {
    --header-font: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  /* Utility bar — top strip above nav */
  .utility-bar {
    background: #162b49;
    color: white;
    font-family: var(--header-font);
    font-size: 13px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .utility-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 8px 24px 8px 32px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    flex-wrap: wrap;
  }
  .utility-bar__text {
    color: rgba(255,255,255,0.85);
    white-space: nowrap;
  }
  .utility-bar__link {
    color: #f2b705;
    text-decoration: none;
    font-weight: 600;
  }
  .utility-bar__link:hover {
    text-decoration: underline;
  }
  .utility-bar__separator {
    color: rgba(255,255,255,0.3);
    font-size: 10px;
  }
  .utility-bar__actions {
    margin-left: auto;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  .utility-bar__btn {
    display: inline-flex;
    align-items: center;
    padding: 5px 14px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    font-size: 12px;
    background: rgba(255,255,255,0.12);
    color: white;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .utility-bar__btn:hover {
    background: rgba(255,255,255,0.2);
  }
  .utility-bar__btn--primary {
    background: #cf2333;
  }
  .utility-bar__btn--primary:hover {
    background: #b81e2c;
  }
  @media (max-width: 768px) {
    .utility-bar__inner {
      padding: 5px 12px;
      gap: 4px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .utility-bar__text {
      font-size: 10px;
      white-space: normal;
      flex: none;
      min-width: 0;
    }
    .utility-bar__separator {
      display: none;
    }
    .utility-bar__actions {
      margin-left: 0;
      flex-shrink: 0;
    }
    .utility-bar__btn {
      font-size: 10px;
      padding: 3px 8px;
    }
  }
  @media (max-width: 400px) {
    .utility-bar__inner {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2px 8px;
      padding: 4px 8px;
    }
    .utility-bar__text {
      font-size: 9px;
      text-align: center;
      flex: none;
    }
    .utility-bar__actions {
      width: auto;
      justify-content: center;
      gap: 4px;
    }
    .utility-bar__btn {
      font-size: 9px;
      padding: 2px 8px;
    }
  }

  /* ── Desktop Header ───────────────────────────────── */
  .header-wrapper {
    position: sticky;
    top: 0;
    z-index: 101;
    background: #162b49;
    border-bottom: 2px solid #f2b705;
  }

  .header {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0;
    height: 60px;
    padding-left: 8px;
  }

  .header__logo {
    flex-shrink: 0;
    margin-right: 24px;
  }

  .header__logo-link { display: block; text-decoration: none; }

  .header__logo-text {
    display: block;
    text-decoration: none;
    color: #ffffff;
    font-family: var(--header-font);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .header__logo-image {
    height: 34px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .header__nav {
    flex: 1;
    display: flex;
    justify-content: flex-start;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0;
  }

  .header__nav-item {
    margin: 0;
    padding: 0;
    position: relative;
  }

  .header__nav-link {
    display: flex;
    align-items: center;
    height: 60px;
    padding: 0 12px;
    text-decoration: none;
    color: #94a3b8;
    font-family: var(--header-font);
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    letter-spacing: 0.01em;
    transition: color 0.2s ease;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    gap: 4px;
  }

  .header__nav-link:hover,
  .header__nav-link.is-active {
    color: #ffffff;
    border-bottom-color: #f2b705;
  }

  .header__nav-item--dropdown:hover .header__nav-dropdown-toggle {
    color: #ffffff;
    border-bottom-color: #f2b705;
  }

  .header__nav-chevron {
    color: #94a3b8;
    transition: transform 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .header__nav-item--dropdown:hover .header__nav-chevron,
  .header__nav-item--dropdown.is-open .header__nav-chevron {
    transform: rotate(180deg);
    color: #ffffff;
  }

  .header__nav-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 2px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 180px;
    background: #1e3a5f;
    border: 1px solid #2d4a6f;
    border-top: 2px solid #f2b705;
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    padding: 6px 0;
    margin: 0;
    list-style: none;
    z-index: 200;
    border-radius: 0 0 6px 6px;
  }

  @media (min-width: 769px) {
    .header__nav-item--dropdown:hover .header__nav-dropdown,
    .header__nav-item--dropdown.is-open .header__nav-dropdown {
      display: block;
    }
  }

  .header__nav-item--dropdown.is-open .header__nav-dropdown {
    display: block;
  }

  .header__nav-dropdown-link {
    display: block;
    padding: 9px 18px;
    color: #cbd5e1;
    text-decoration: none;
    font-family: var(--header-font);
    font-size: 13px;
    font-weight: 500;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .header__nav-dropdown-link:hover {
    color: #ffffff;
    background: #2d4a6f;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    margin-left: 16px;
  }

  .header__menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: 40px;
    padding: 0 8px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: #ffffff;
    font: 600 12px/1 var(--header-font);
    cursor: pointer;
  }

  .header__menu-btn:hover,
  .header__menu-btn:focus-visible {
    background: rgba(255,255,255,0.08);
  }

  .header__menu-btn svg {
    width: 20px;
    height: 20px;
  }

  .header__cart-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    color: #94a3b8;
    transition: color 0.2s ease, background 0.2s ease;
    border-radius: 4px;
    position: relative;
    text-decoration: none;
  }

  .header__cart-btn:hover {
    color: #ffffff;
    background: rgba(255,255,255,0.08);
  }

  .header__cart-btn svg {
    display: block;
    width: 22px;
    height: 22px;
  }

  .header__cart-badge {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 17px;
    height: 17px;
    border-radius: 50%;
    background-color: #f2b705;
    color: #162b49;
    font-family: var(--header-font);
    font-size: 10px;
    font-weight: 700;
    line-height: 17px;
    text-align: center;
    padding: 0 4px;
    box-sizing: border-box;
    pointer-events: none;
  }

  /* ── Mobile Bottom Nav ─────────────────────────────── */
  .mobile-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #162b49;
    border-top: 1px solid #2d4a6f;
    z-index: 500;
    padding: 0;
    list-style: none;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .mobile-nav {
      display: flex;
      padding-bottom: env(safe-area-inset-bottom);
      box-shadow: 0 -8px 24px rgba(9, 20, 37, 0.14);
    }
    body { padding-bottom: calc(62px + env(safe-area-inset-bottom)); }
  }

  .mobile-nav__item {
    flex: 1;
    text-align: center;
    border: none;
    border-right: 1px solid #2d4a6f;
  }

  .mobile-nav__item:last-child { border-right: none; }

  .mobile-nav__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 8px 4px;
    text-decoration: none;
    color: #94a3b8;
    font-family: var(--header-font);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
    background: none;
    width: 100%;
    border: none;
    cursor: pointer;
  }

  .mobile-nav__link svg {
    width: 22px;
    height: 22px;
    display: block;
    flex-shrink: 0;
  }

  .mobile-nav__link:hover,
  .mobile-nav__link.is-active {
    color: #f2b705;
  }

  .mobile-nav__cart-badge {
    position: absolute;
    top: 2px;
    right: calc(50% - 18px);
    min-width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #f2b705;
    color: #162b49;
    font-size: 9px;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
    padding: 0 3px;
    pointer-events: none;
  }

  .mobile-nav__item--cart {
    position: relative;
  }

  .mobile-menu-overlay[hidden] { display: none !important; }

  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 650;
    background: rgba(9, 20, 37, 0.58);
    display: flex;
    justify-content: flex-end;
  }

  .mobile-menu-panel {
    width: min(88vw, 360px);
    height: 100%;
    overflow-y: auto;
    padding: max(18px, env(safe-area-inset-top)) 20px calc(26px + env(safe-area-inset-bottom));
    background: #ffffff;
    box-shadow: -18px 0 48px rgba(9, 20, 37, 0.2);
    font-family: var(--header-font);
  }

  .mobile-menu-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    color: #162b49;
    font-size: 20px;
  }

  .mobile-menu-panel__close {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: #f4f1e9;
    color: #162b49;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
  }

  .mobile-menu-panel > a,
  .mobile-menu-panel__brands a {
    display: block;
    padding: 13px 4px;
    border-bottom: 1px solid #e8e5dd;
    color: #162b49;
    text-decoration: none;
    font-size: 16px;
    font-weight: 650;
  }

  .mobile-menu-panel__label {
    margin-top: 20px;
    color: #667085;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mobile-menu-panel__brands {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 18px;
  }

  .mobile-menu-panel__brands a { font-size: 14px; }

  .mobile-menu-panel__cart {
    width: 100%;
    margin-top: 22px;
    padding: 14px 18px;
    border: 0;
    border-radius: 6px;
    background: #f2b705;
    color: #162b49;
    font: 800 15px/1 var(--header-font);
    cursor: pointer;
  }

  /* ── Mobile Header Adjustments ──────────────────────── */
  @media screen and (max-width: 768px) {
    .header__nav {
      display: none;
    }

    .header__menu-btn { display: inline-flex; }

    .header {
      padding: 0 16px;
    }

    .header__container {
      height: 50px;
    }

    .header__logo-image {
      height: 28px;
    }

    .header__logo-text {
      font-size: 16px;
    }

    .header__logo {
      margin-right: 0;
    }

    .header__cart-btn {
      width: 36px;
      height: 36px;
    }

    .header__cart-btn svg {
      width: 18px;
      height: 18px;
    }

    .header__cart-badge {
      top: 2px;
      right: 0px;
      min-width: 15px;
      height: 15px;
      font-size: 9px;
      line-height: 15px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var menuButton = document.querySelector('.header__menu-btn');
    var menuOverlay = document.querySelector('[data-mobile-menu-overlay]');
    var menuClose = document.querySelector('[data-mobile-menu-close]');

    function closeMobileMenu() {
      if (!menuOverlay || !menuButton) return;
      menuOverlay.hidden = true;
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
      menuButton.focus();
    }

    function openMobileMenu() {
      if (!menuOverlay || !menuButton) return;
      menuOverlay.hidden = false;
      menuButton.setAttribute('aria-expanded', 'true');
      menuButton.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
      menuClose?.focus();
    }

    menuButton?.addEventListener('click', function() {
      if (menuOverlay?.hidden) openMobileMenu();
      else closeMobileMenu();
    });
    menuClose?.addEventListener('click', closeMobileMenu);
    menuOverlay?.addEventListener('click', function(event) {
      if (event.target === menuOverlay) closeMobileMenu();
    });
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && menuOverlay && !menuOverlay.hidden) closeMobileMenu();
    });

    var dropdownToggles = document.querySelectorAll('.header__nav-dropdown-toggle');
    dropdownToggles.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var item = this.closest('.header__nav-item--dropdown');
        var isOpen = item.classList.toggle('is-open');
        this.setAttribute('aria-expanded', isOpen);
      });

      btn.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          var item = this.closest('.header__nav-item--dropdown');
          item.classList.remove('is-open');
          this.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('.header__nav-item--dropdown')) {
        document.querySelectorAll('.header__nav-item--dropdown.is-open').forEach(function(el) {
          el.classList.remove('is-open');
          el.querySelector('.header__nav-dropdown-toggle').setAttribute('aria-expanded', 'false');
        });
      }
    });
  });
</script>

