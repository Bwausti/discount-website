<footer class="dm-footer">
  <div class="dm-footer__inner">
    <div class="dm-footer__brand">
      <img src="{{ 'logo.png' | asset_url }}" alt="Discount Mattress" width="210" height="36" loading="lazy">
      <p>Better sleep starts with the right fit. Shop leading brands online or get local help in Bowling Green.</p>
      <div class="dm-footer__actions">
        <a href="/collections/all">Shop mattresses</a>
        <a href="/pages/locations" class="is-secondary">Visit a showroom</a>
      </div>
    </div>

    <nav class="dm-footer__nav" aria-label="Footer navigation">
      <div>
        <h2>Shop</h2>
        <a href="/collections/helix">Helix</a>
        <a href="/collections/puffy">Puffy</a>
        <a href="/collections/dreamcloud">DreamCloud</a>
        <a href="/collections/nectar">Nectar</a>
        <a href="/collections/serta">Serta</a>
        <a href="/collections">All brands</a>
      </div>
      <div>
        <h2>Help</h2>
        <a href="/pages/brand-comparisons">Compare brands</a>
        <a href="/pages/financing">Financing</a>
        <a href="/pages/faq">FAQ</a>
        <a href="/pages/contact">Contact</a>
        <a href="/pages/locations">Locations &amp; hours</a>
      </div>
    </nav>

    <div class="dm-footer__locations">
      <h2>Bowling Green</h2>
      <address>
        <strong>Campbell Lane</strong>
        <span>1555 Campbell Ln, Bowling Green, KY 42104</span>
        <a href="tel:+12704951603">(270) 495-1603</a>
      </address>
      <address>
        <strong>Mattress Outlet</strong>
        <span>2734 Russellville Rd, Bowling Green, KY 42101</span>
        <a href="tel:+12708423888">(270) 842-3888</a>
      </address>
    </div>
  </div>

  <div class="dm-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} Discount Mattress. Bowling Green, Kentucky.</p>
    <div>
      <a href="/policies/privacy-policy">Privacy</a>
      <a href="/policies/refund-policy">Returns</a>
      <a href="/policies/shipping-policy">Shipping</a>
      <a href="/policies/terms-of-service">Terms</a>
    </div>
  </div>
</footer>

<style>
  .dm-footer { padding: 68px 22px 26px; background: #101d32; color: #fff; }
  .dm-footer__inner { display: grid; grid-template-columns: minmax(280px,1.15fr) minmax(310px,1fr) minmax(260px,.8fr); gap: 64px; max-width: 1180px; margin: 0 auto; }
  .dm-footer__brand img { display: block; width: auto; max-width: 210px; height: 36px; object-fit: contain; object-position: left center; filter: brightness(0) invert(1); }
  .dm-footer__brand > p { max-width: 420px; margin: 22px 0; color: #b8c4d3; font-size: 14px; line-height: 1.65; }
  .dm-footer__actions { display: flex; flex-wrap: wrap; gap: 9px; }
  .dm-footer__actions a { padding: 10px 14px; border-radius: 8px; background: #c9233b; color: #fff; font-size: 12px; font-weight: 800; text-decoration: none; }
  .dm-footer__actions a.is-secondary { background: rgba(255,255,255,.09); }
  .dm-footer__nav { display: grid; grid-template-columns: repeat(2,1fr); gap: 42px; }
  .dm-footer h2 { margin: 0 0 18px; color: #fff; font-size: 11px; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .dm-footer__nav a { display: block; width: fit-content; margin: 0 0 11px; color: #b8c4d3; font-size: 13px; text-decoration: none; }
  .dm-footer a:hover { color: #fff; }
  .dm-footer__locations address { display: flex; flex-direction: column; gap: 5px; margin: 0 0 22px; color: #b8c4d3; font-size: 13px; font-style: normal; line-height: 1.45; }
  .dm-footer__locations strong { color: #fff; }
  .dm-footer__locations a { color: #fff; font-weight: 750; text-decoration: none; }
  .dm-footer__bottom { display: flex; align-items: center; justify-content: space-between; gap: 20px; max-width: 1180px; margin: 48px auto 0; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.11); color: #8292a8; font-size: 11px; }
  .dm-footer__bottom p { margin: 0; }
  .dm-footer__bottom div { display: flex; flex-wrap: wrap; gap: 18px; }
  .dm-footer__bottom a { color: #8292a8; text-decoration: none; }
  @media (max-width: 900px) {
    .dm-footer__inner { grid-template-columns: 1fr 1fr; gap: 46px; }
    .dm-footer__brand { grid-column: 1/-1; }
  }
  @media (max-width: 600px) {
    .dm-footer { padding: 52px 18px 86px; }
    .dm-footer__inner { grid-template-columns: 1fr; gap: 38px; }
    .dm-footer__brand { grid-column: auto; }
    .dm-footer__bottom { align-items: flex-start; flex-direction: column; margin-top: 38px; }
  }
</style>

{% schema %}
{
  "name": "Custom footer",
  "settings": [],
  "presets": [{ "name": "Custom footer" }]
}
{% endschema %}
