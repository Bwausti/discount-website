    {%- capture layer_data_raw -%}Organic Cotton Cover|0.25|Breathable organic cotton cover.|Cotton||Cooling Gel Memory Foam|2.0|Gel-infused memory foam for pressure relief.|Cooling Gel||Individually Wrapped Coils|6.0|Pocket coil system for support and airflow.|Coils||High-Density Support Foam|4.0|Stable support foam foundation.|Support{%- endcapture -%}

  {%- comment %}══════ POSH & LAVISH ══════{% endcomment %}
  {%- when "posh-and-lavish-mattress" -%}
    {%- capture layer_data_raw -%}Quilted Euro Top Cover|0.5|Plush euro-top cover with fiber padding.|PillowTop||Gel-Infused Memory Foam|2.0|Cooling gel memory foam for pressure relief.|Memory||Individually Wrapped Coils|6.0|Pocket coil system for support.|Coils||High-Density Support Foam|4.0|Durable support core.|Support{%- endcapture -%}

{%- endcase -%}

{%- if layer_data_raw == "" -%}
  <!-- No layer data for product: {{ product_handle }} -->
{%- else -%}
  <!-- Layer data found for: {{ product_handle }} -->

{%- comment %}━━━ RENDER ━━━{% endcomment %}
{%- assign layers = layer_data_raw | strip | split: "||" -%}
{%- assign total_height = 0 -%}
{%- for layer in layers -%}
  {%- assign parts = layer | split: "|" -%}
  {%- assign thickness = parts[1] | plus: 0 -%}
  {%- assign total_height = total_height | plus: thickness -%}
{%- endfor -%}

<style>
  .layer-diagram { font-family: 'Inter', 'Segoe UI', sans-serif; max-width: 1300px; margin: 0 auto; padding: 40px 24px; }
  .layer-diagram__header { margin-bottom: 32px; }
  .layer-diagram__header .section-label {
    display: inline-block; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.22em;
    color: var(--color-accent, #2563eb); margin-bottom: 8px;
  }
  .layer-diagram__header h2 {
    font-size: clamp(24px, 2.8vw, 36px); font-weight: 900; color: #111; line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 8px 0;
  }
  .layer-diagram__header p { font-size: 15px; color: #64748b; line-height: 1.6; margin: 0; max-width: 600px; }
  .layer-diagram__columns { display: grid; grid-template-columns: 1fr 1.3fr; gap: 40px; align-items: start; }
  @media (max-width: 860px) { .layer-diagram__columns { grid-template-columns: 1fr !important; } }
  .layer-stack { position: relative; padding: 20px 0; }
  .layer-stack__inner {
    display: flex; flex-direction: column-reverse; gap: 3px;
    border-radius: 10px; overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
  }
  .layer-stack__layer {
    padding: 14px 18px; display: flex; align-items: center; gap: 14px;
    position: relative; overflow: hidden; min-height: 52px;
    transition: transform 0.2s;
  }
  .layer-stack__layer:hover { transform: scale(1.01); z-index: 2; }
  .layer-stack__layer--base { background: #1e293b; }
  .layer-stack__layer--coils { background: #94a3b8; }
  .layer-stack__layer--support { background: #4a5a6e; }
  .layer-stack__layer--transition { background: #6b7c90; }
  .layer-stack__layer--foam { background: #7c8b9e; }
  .layer-stack__layer--memory { background: #b4a7d6; }
  .layer-stack__layer--cooling-gel { background: #67b5d6; }
  .layer-stack__layer--cooling { background: #89cff0; }
  .layer-stack__layer--wool { background: #c4a882; }
  .layer-stack__layer--cotton { background: #d4c5a9; }
  .layer-stack__layer--pillowtop { background: #e8d8c8; }
  .layer-stack__layer--cover { background: #f0ece6; }
  .layer-stack__layer--fabric { background: #d0d4d8; }
  .layer-stack__layer--default { background: #b0b8c4; }
  .layer-stack__info { flex: 1; min-width: 0; }
  .layer-stack__name {
    font-size: 14px; font-weight: 800; color: white;
    text-shadow: 0 1px 3px rgba(0,0,0,0.3);
  }
  .layer-stack__thickness {
    font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.8);
    background: rgba(0,0,0,0.25); padding: 2px 8px; border-radius: 4px;
    margin-left: 8px; white-space: nowrap;
  }
  .layer-stack__desc {
    font-size: 11px; color: rgba(255,255,255,0.75); line-height: 1.4; margin-top: 2px;
    max-width: 400px;
  }
  .layer-details { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; }
  .layer-details h3 {
    font-size: 18px; font-weight: 800; color: #111; margin: 0 0 16px 0;
    letter-spacing: -0.01em;
  }
  .layer-details__total {
    display: flex; align-items: center; gap: 12px; padding: 14px; background: white;
    border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 16px;
  }
  .layer-details__total-value { font-size: 28px; font-weight: 900; color: #111; }
  .layer-details__total-label { font-size: 12px; color: #64748b; font-weight: 600; }
  .layer-details__features { display: flex; flex-wrap: wrap; gap: 8px; }
  .layer-details__feature {
    background: white; border: 1px solid #e2e8f0; border-radius: 20px;
    padding: 5px 14px; font-size: 12px; font-weight: 600; color: #334155;
  }
  .layer-cta {
    margin-top: 24px; padding: 16px 20px; background: white;
    border: 1px solid #e2e8f0; border-radius: 8px; font-size: 13px; color: #475569; line-height: 1.6;
  }
  .layer-cta strong { color: #111; }
  .layer-diagram__note { margin-top: 16px; font-size: 12px; color: #94a3b8; text-align: center; font-style: italic; }
</style>

<div class="layer-diagram">
  <div class="layer-diagram__header">
    <span class="section-label">Construction</span>
    <h2>What's inside this mattress</h2>
    <p>See exactly how each layer works together for your comfort and support.</p>
  </div>

  <div class="layer-diagram__columns">
    {% comment %} Left: Visual Stack {% endcomment %}
    <div class="layer-stack">
      <div class="layer-stack__inner">
        {%- for layer in layers -%}
          {%- assign parts = layer | split: "|" -%}
          {%- assign layer_name = parts[0] | strip -%}
          {%- assign layer_thickness = parts[1] | strip -%}
          {%- assign layer_desc = parts[2] | strip -%}
          {%- assign layer_label = parts[3] | strip -%}

          {%- assign layer_class = "layer-stack__layer--default" -%}
          {%- assign lc = layer_label | downcase -%}
          {%- if lc contains "base" or lc contains "grip" -%}{%- assign layer_class = "layer-stack__layer--base" -%}
          {%- elsif lc contains "coil" or lc contains "spring" -%}{%- assign layer_class = "layer-stack__layer--coils" -%}
          {%- elsif lc contains "support" -%}{%- assign layer_class = "layer-stack__layer--support" -%}
          {%- elsif lc contains "transition" -%}{%- assign layer_class = "layer-stack__layer--transition" -%}
          {%- elsif lc contains "memory" -%}{%- assign layer_class = "layer-stack__layer--memory" -%}
          {%- elsif lc == "cooling gel" -%}{%- assign layer_class = "layer-stack__layer--cooling-gel" -%}
          {%- elsif lc contains "cooling" or lc contains "cool" -%}{%- assign layer_class = "layer-stack__layer--cooling" -%}
          {%- elsif lc contains "wool" -%}{%- assign layer_class = "layer-stack__layer--wool" -%}
          {%- elsif lc contains "cotton" -%}{%- assign layer_class = "layer-stack__layer--cotton" -%}
          {%- elsif lc contains "pillow" or lc contains "euro" or lc contains "top" -%}{%- assign layer_class = "layer-stack__layer--pillowtop" -%}
          {%- elsif lc contains "cover" or lc contains "quilted" -%}{%- assign layer_class = "layer-stack__layer--cover" -%}
          {%- elsif lc contains "fabric" or lc contains "knit" -%}{%- assign layer_class = "layer-stack__layer--fabric" -%}
          {%- elsif lc contains "foam" -%}{%- assign layer_class = "layer-stack__layer--foam" -%}
          {%- endif -%}

          <div class="layer-stack__layer {{ layer_class }}">
            <div class="layer-stack__info">
              <span class="layer-stack__name">{{ layer_name }}
                <span class="layer-stack__thickness">{{ layer_thickness }}"</span>
              </span>
              <p class="layer-stack__desc">{{ layer_desc }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {% comment %} Right: Details Panel {% endcomment %}
    <div class="layer-details">
      <h3>Layer breakdown</h3>
      <div class="layer-details__total">
        <div class="layer-details__total-value">{{ total_height }}"</div>
        <div class="layer-details__total-label">Total mattress height</div>
      </div>
      <div class="layer-details__features">
        <span class="layer-details__feature">🏗️ {{ layers.size }} layers</span>
        {%- assign has_coils = false -%}{%- assign has_memory = false -%}{%- assign has_cooling = false -%}{%- assign has_cotton = false -%}
        {%- for layer in layers -%}
          {%- assign p = layer | split: "|" -%}{%- assign lb = p[3] | default: "" | downcase -%}
          {%- if lb contains "coil" -%}{%- assign has_coils = true -%}{%- endif -%}
          {%- if lb contains "memory" -%}{%- assign has_memory = true -%}{%- endif -%}
          {%- if lb contains "cooling" or lb contains "gel" -%}{%- assign has_cooling = true -%}{%- endif -%}
          {%- if lb contains "cotton" or lb contains "wool" -%}{%- assign has_cotton = true -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_coils -%}<span class="layer-details__feature">🔩 Pocket coils</span>{%- endif -%}
        {%- if has_memory -%}<span class="layer-details__feature">🧊 Memory foam layer</span>{%- endif -%}
        {%- if has_cooling -%}<span class="layer-details__feature">❄️ Cooling technology</span>{%- endif -%}
        {%- if has_cotton -%}<span class="layer-details__feature">🌱 Natural materials</span>{%- endif -%}
      </div>
      <div class="layer-cta">
        <strong>Come feel the difference.</strong> Stop by our showroom to try each model. Your body knows best — lie down on the actual layers and compare.
      </div>
    </div>
  </div>
  <p class="layer-diagram__note">Layers shown from top (surface) to bottom (base). Heights are approximate.</p>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Mattress Layer Diagram",
  "settings": [],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
