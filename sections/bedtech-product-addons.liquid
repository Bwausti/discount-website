{% comment %}
  bedtech-product-addons.liquid
  Shows BedTech adjustable base tier comparison on product pages
  Only renders on BedTech products
{% endcomment %}

{% assign is_bedtech_product = false %}
{% if closest.product.vendor == "BedTech" %}
  {% assign is_bedtech_product = true %}
  {% assign title_lower = closest.product.title | downcase %}
  {% assign is_adjustable = false %}
  {% assign is_platform = false %}
  {% if title_lower contains "adjustable" %}
    {% assign is_adjustable = true %}
  {% else %}
    {% assign is_platform = true %}
  {% endif %}
{% endif %}

{% if is_bedtech_product %}

<style>
  .bt-addons {
    background: #0f172a;
    border-top: 1px solid #1e293b;
    padding: 48px 24px;
    margin-top: 0;
  }
  .bt-addons__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .bt-addons__header {
    margin-bottom: 32px;
  }
  .bt-addons__label {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #38bdf8;
    margin-bottom: 8px;
  }
  .bt-addons__title {
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin: 0 0 8px 0;
  }
  .bt-addons__sub {
    font-size: 14px;
    color: #94a3b8;
    margin: 0;
  }

  /* Adjustable base comparison */
  .bt-compare {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 12px;
    margin-bottom: 40px;
  }
  .bt-card {
    background: #1e293b;
    border: 2px solid transparent;
    border-radius: 10px;
    padding: 20px 16px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    position: relative;
  }
  .bt-card:hover {
    border-color: #38bdf8;
    box-shadow: 0 6px 24px rgba(0,0,0,0.3);
    transform: translateY(-2px);
  }
  .bt-card.active {
    border-color: #38bdf8;
    background: #1a2a40;
  }
  .bt-card.active::after {
    content: 'Current';
    position: absolute;
    top: -8px;
    right: 12px;
    background: #38bdf8;
    color: #0f172a;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 10px;
    border-radius: 4px;
  }
  .bt-card__badge {
    display: inline-block;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 3px 10px;
    border-radius: 4px;
    background: #334155;
    color: #cbd5e1;
    width: fit-content;
  }
  .bt-card__badge.entry { background: #2d3748; color: #94a3b8; }
  .bt-card__badge.mid { background: #1e3a5f; color: #93c5fd; }
  .bt-card__badge.premium { background: #312e81; color: #a5b4fc; }
  .bt-card__badge.top { background: #581c87; color: #d8b4fe; }
  .bt-card__name {
    font-size: 16px;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }
  .bt-card__features {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .bt-card__feature {
    font-size: 12px;
    color: #94a3b8;
    margin: 0;
    padding-left: 12px;
  }
  .bt-card__feature::before {
    content: '▸';
    color: #38bdf8;
    margin-right: 6px;
  }
  .bt-card__price {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    margin: 8px 0 0 0;
  }
  .bt-card__cta {
    font-size: 12px;
    font-weight: 800;
    color: #38bdf8;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
  }
  .bt-card:hover .bt-card__cta { gap: 8px; }

  /* Platform / Foundation section */
  .bt-section-label {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #38bdf8;
    margin: 0 0 16px 0;
  }
  .bt-platforms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }
  .bt-platform-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 16px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .bt-platform-card:hover {
    border-color: #38bdf8;
    box-shadow: 0 6px 24px rgba(0,0,0,0.3);
    transform: translateY(-2px);
  }
  .bt-platform-card.active {
    border-color: #38bdf8;
    background: #1a2a40;
  }
  .bt-platform-card__name {
    font-size: 14px;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }
  .bt-platform-card__price {
    font-size: 13px;
    font-weight: 700;
    color: #38bdf8;
    margin: 0;
  }
  .bt-platform-card__cta {
    font-size: 11px;
    font-weight: 800;
    color: #38bdf8;
    text-transform: uppercase;
  }
</style>

<div class="bt-addons">
  <div class="bt-addons__inner{% if is_platform %} bt-addons__inner--platform{% endif %}">

    <!-- Header -->
    <div class="bt-addons__header">
      <p class="bt-addons__label">BedTech Adjustable Bases</p>
      <h2 class="bt-addons__title">Find your perfect base</h2>
      <p class="bt-addons__sub">From essential lift to full luxury — 7 adjustable base models to fit every budget</p>
    </div>

    <!-- Adjustable bases comparison -->
    <div class="bt-compare">
      {% if is_adjustable %}
        {% assign is_bthu = false %}{% assign is_bt2000 = false %}{% assign is_bt2500 = false %}{% assign is_bt3000 = false %}{% assign is_btx4 = false %}{% assign is_btx5 = false %}{% assign is_bt6500 = false %}
        {% if title_lower contains "bthu" %}{% assign is_bthu = true %}{% elsif title_lower contains "btx5" %}{% assign is_btx5 = true %}{% elsif title_lower contains "btx4" %}{% assign is_btx4 = true %}{% elsif title_lower contains "bt6500" %}{% assign is_bt6500 = true %}{% elsif title_lower contains "bt3000" %}{% assign is_bt3000 = true %}{% elsif title_lower contains "bt2500" %}{% assign is_bt2500 = true %}{% elsif title_lower contains "bt2000" %}{% assign is_bt2000 = true %}{% endif %}
      {% endif %}

      {% if is_bthu %}
        <div class="bt-card active">
          <span class="bt-card__badge entry">Entry</span>
          <h3 class="bt-card__name">BTHU</h3>
          <p class="bt-card__price">$399</p>
          <p class="bt-card__cta">You're viewing →</p>
        </div>
      {% else %}
        <a href="/products/bedtech-bthu" class="bt-card">
          <span class="bt-card__badge entry">Entry</span>
          <h3 class="bt-card__name">BTHU</h3>
          <p class="bt-card__price">$399</p>
          <p class="bt-card__cta">View →</p>
        </a>
      {% endif %}

      {% if is_bt2000 %}
        <div class="bt-card active">
          <span class="bt-card__badge entry">Entry+</span>
          <h3 class="bt-card__name">BT2000</h3>
          <p class="bt-card__price">$625</p>
          <p class="bt-card__cta">You're viewing →</p>
        </div>
      {% else %}
        <a href="/products/bedtech-bt2000" class="bt-card">
          <span class="bt-card__badge entry">Entry+</span>
          <h3 class="bt-card__name">BT2000</h3>
          <p class="bt-card__price">$625</p>
          <p class="bt-card__cta">View →</p>
        </a>
      {% endif %}

      {% if is_bt2500 %}
        <div class="bt-card active">
          <span class="bt-card__badge mid">Mid</span>
          <h3 class="bt-card__name">BT2500</h3>
          <p class="bt-card__price">$725</p>
          <p class="bt-card__cta">You're viewing →</p>
        </div>
      {% else %}
        <a href="/products/bedtech-bt2500" class="bt-card">
          <span class="bt-card__badge mid">Mid</span>
          <h3 class="bt-card__name">BT2500</h3>
          <p class="bt-card__price">$725</p>
          <p class="bt-card__cta">View →</p>
        </a>
      {% endif %}

      {% if is_bt3000 %}
        <div class="bt-card active">
          <span class="bt-card__badge mid">Mid+</span>
          <h3 class="bt-card__name">BT3000</h3>
          <p class="bt-card__price">$825</p>
          <p class="bt-card__cta">You're viewing →</p>
        </div>
      {% else %}
        <a href="/products/bedtech-bt3000" class="bt-card">
          <span class="bt-card__badge mid">Mid+</span>
          <h3 class="bt-card__name">BT3000</h3>
          <p class="bt-card__price">$825</p>
          <p class="bt-card__cta">View →</p>
        </a>
      {% endif %}

      {% if is_btx4 %}
        <div class="bt-card active">
          <span class="bt-card__badge premium">Premium</span>
          <h3 class="bt-card__name">BTX4</h3>
          <p class="bt-card__price">$575</p>
          <p class="bt-card__cta">You're viewing →</p>
        </div>
      {% else %}
        <a href="/products/bedtech-btx4" class="bt-card">
          <span class="bt-card__badge premium">Premium</span>
          <h3 class="bt-card__name">BTX4</h3>
          <p class="bt-card__price">$575</p>
          <p class="bt-card__cta">View →</p>
        </a>
      {% endif %}

      {% if is_btx5 %}
        <div class="bt-card active">
          <span class="bt-card__badge premium">Premium+</span>
          <h3 class="bt-card__name">BTX5</h3>
          <p class="bt-card__price">$675</p>
          <p class="bt-card__cta">You're viewing →</p>
        </div>
      {% else %}
        <a href="/products/bedtech-btx5" class="bt-card">
          <span class="bt-card__badge premium">Premium+</span>
          <h3 class="bt-card__name">BTX5</h3>
          <p class="bt-card__price">$675</p>
          <p class="bt-card__cta">View →</p>
        </a>
      {% endif %}

      {% if is_bt6500 %}
        <div class="bt-card active">
          <span class="bt-card__badge top">Top</span>
          <h3 class="bt-card__name">BT6500</h3>
          <p class="bt-card__price">$1,100</p>
          <p class="bt-card__cta">You're viewing →</p>
        </div>
      {% else %}
        <a href="/products/bedtech-bt6500" class="bt-card">
          <span class="bt-card__badge top">Top</span>
          <h3 class="bt-card__name">BT6500</h3>
          <p class="bt-card__price">$1,100</p>
          <p class="bt-card__cta">View →</p>
        </a>
      {% endif %}
    </div>

    <!-- Platforms / Foundations -->
    <p class="bt-section-label">Platforms & Foundations</p>
    <div class="bt-platforms">

      {% assign is_upholstered = false %}{% assign is_standard = false %}{% assign is_highrise = false %}{% assign is_modern = false %}
      {% if title_lower contains "upholstered" %}{% assign is_upholstered = true %}{% elsif title_lower contains "standard" %}{% assign is_standard = true %}{% elsif title_lower contains "high rise" %}{% assign is_highrise = true %}{% elsif title_lower contains "modern" %}{% assign is_modern = true %}{% endif %}

      <a href="/products/bedtech-upholstered-platform" class="bt-platform-card">
        <h3 class="bt-platform-card__name">Upholstered Platform</h3>
        <p class="bt-platform-card__price">$125</p>
        <p class="bt-platform-card__cta">{% if is_upholstered %}You're viewing →{% else %}View →{% endif %}</p>
      </a>

      <a href="/products/bedtech-standard-foundation" class="bt-platform-card">
        <h3 class="bt-platform-card__name">Standard Foundation</h3>
        <p class="bt-platform-card__price">$100</p>
        <p class="bt-platform-card__cta">{% if is_standard %}You're viewing →{% else %}View →{% endif %}</p>
      </a>

      <a href="/products/bedtech-high-rise-platform" class="bt-platform-card">
        <h3 class="bt-platform-card__name">High Rise Platform</h3>
        <p class="bt-platform-card__price">$99</p>
        <p class="bt-platform-card__cta">{% if is_highrise %}You're viewing →{% else %}View →{% endif %}</p>
      </a>

      <a href="/products/bedtech-modern-platform" class="bt-platform-card">
        <h3 class="bt-platform-card__name">Modern Platform</h3>
        <p class="bt-platform-card__price">$99</p>
        <p class="bt-platform-card__cta">{% if is_modern %}You're viewing →{% else %}View →{% endif %}</p>
      </a>

    </div>
  </div>
</div>

{% endif %}

{% schema %}
{
  "name": "BedTech Product Add-ons",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": []
}
{% endschema %}
