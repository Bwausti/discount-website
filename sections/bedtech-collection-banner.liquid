        <p class="bedtech-trust__label">Products</p>
        <p class="bedtech-trust__value">11</p>
      </div>
      <div class="bedtech-trust__item">
        <p class="bedtech-trust__label">Warranty</p>
        <p class="bedtech-trust__value">20-year</p>
      </div>
      <div class="bedtech-trust__item">
        <p class="bedtech-trust__label">Price match</p>
