<style>
  .ct-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .ct-card {
    text-decoration: none;
    border-radius: 12px;
    overflow: hidden;
    background: white;
    display: block;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ct-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
  }

  .ct-card-image {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #e8e4dc;
  }

  .ct-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .ct-card:hover .ct-card-image img {
    transform: scale(1.04);
  }

  .ct-card-badge {
    position: absolute;
    bottom: 12px;
    left: 14px;
    background: rgba(255,255,255,0.95);
    padding: 5px 12px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    color: #162b49;
    white-space: nowrap;
  }

  .ct-card-body {
    padding: 18px 20px;
  }

  .ct-card-title {
    font-size: 17px;
    font-weight: 800;
    color: #162b49;
    margin: 0 0 4px 0;
    line-height: 1.2;
  }

  .ct-card-desc {
    color: #64748b;
    font-size: 13px;
    line-height: 1.5;
    margin: 0;
  }

  .ct-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .ct-header-heading {
    font-size: clamp(24px, 3.5vw, 34px);
    font-weight: 800;
    color: #162b49;
    margin: 0 0 6px 0;
    line-height: 1.1;
  }

  .ct-header-sub {
    color: #64748b;
    font-size: 15px;
    margin: 0;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .ct-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .ct-card-image {
      aspect-ratio: 1/1;
    }

    .ct-card:hover {
      transform: none;
    }

    .ct-card-body {
      padding: 14px 16px;
    }

    .ct-card-title {
      font-size: 15px;
    }

    .ct-card-desc {
      font-size: 12px;
      display: none;
    }

    .ct-header {
      flex-direction: column;
      align-items: flex-start !important;
      gap: 16px;
    }

    .ct-header-heading {
      font-size: 22px;
    }

    .ct-header a {
      white-space: normal !important;
      font-size: 13px !important;
      padding: 8px 16px !important;
      width: 100%;
      text-align: center;
      box-sizing: border-box;
    }
  }

  /* Tablet */
  @media (min-width: 769px) and (max-width: 1024px) {
    .ct-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

