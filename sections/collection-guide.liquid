{%- if collection.handle == 'all' -%}
  <section class="dm-collection-guide" aria-labelledby="dm-collection-guide-title">
    <div class="dm-collection-guide__inner">
      <div>
        <p class="dm-collection-guide__eyebrow">A simpler place to start</p>
        <h2 id="dm-collection-guide-title">Find the right mattress faster</h2>
        <p>Browse by comfort goal or brand, then use the filters to narrow size, price, and other available options.</p>
      </div>
      <div class="dm-collection-guide__groups">
        <div>
          <span>Shop by comfort</span>
          <nav aria-label="Shop by comfort">
            <a href="{{ routes.collections_url }}/pressure-relief">Pressure relief</a>
            <a href="{{ routes.collections_url }}/cooling-comfort">Cooling</a>
            <a href="{{ routes.collections_url }}/luxury-feel">Luxury feel</a>
            <a href="{{ routes.collections_url }}/organic-materials">Organic materials</a>
          </nav>
        </div>
        <div>
          <span>Popular brands</span>
          <nav aria-label="Shop popular brands">
            <a href="{{ routes.collections_url }}/helix">Helix</a>
            <a href="{{ routes.collections_url }}/puffy">Puffy</a>
            <a href="{{ routes.collections_url }}/nectar">Nectar</a>
            <a href="{{ routes.collections_url }}/dreamcloud">DreamCloud</a>
          </nav>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .dm-collection-guide { padding: 28px 20px; background: #162b49; color: white; }
  .dm-collection-guide__inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: minmax(280px,.8fr) 1.2fr; gap: 48px; align-items: center; }
  .dm-collection-guide__eyebrow { margin: 0 0 7px; color: #f2b705; font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .dm-collection-guide h2 { margin: 0 0 9px; color: white; font-size: clamp(24px, 3vw, 34px); line-height: 1.08; }
  .dm-collection-guide p { margin: 0; color: rgba(255,255,255,.75); font-size: 14px; line-height: 1.6; }
  .dm-collection-guide__groups { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .dm-collection-guide__groups span { display: block; margin-bottom: 9px; color: rgba(255,255,255,.7); font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .dm-collection-guide nav { display: flex; flex-wrap: wrap; gap: 8px; }
  .dm-collection-guide a { display: inline-flex; padding: 8px 11px; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; color: white; font-size: 12px; font-weight: 700; text-decoration: none; }
  .dm-collection-guide a:hover { border-color: #f2b705; color: #f2b705; }
  @media (max-width: 760px) {
    .dm-collection-guide__inner { grid-template-columns: 1fr; gap: 26px; }
    .dm-collection-guide__groups { grid-template-columns: 1fr; gap: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection guide",
  "settings": [],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
