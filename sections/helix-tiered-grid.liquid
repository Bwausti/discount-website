{% comment %}
  helix-tiered-grid.liquid
  Custom Helix product grid — grouped by Core / Luxe / Elite tiers
  Shows product card with image, title, price, and firmness badge
{% endcomment %}

<style>
  .htg-section {
    font-family: 'Inter', 'Segoe UI', sans-serif;
    max-width: 1300px;
    margin: 0 auto;
    padding: 40px 24px 60px;
  }
  .htg-tier {
    margin-bottom: 48px;
    scroll-margin-top: 80px;
  }
  .htg-tier:last-child { margin-bottom: 0; }
  
  .htg-tier__header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid #e2e8f0;
  }
  .htg-tier__name {
    font-size: 22px;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .htg-tier__count {
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .htg-tier__price-from {
    margin-left: auto;
    font-size: 12px;
    font-weight: 700;
    color: #64748b;
  }
  .htg-tier__price-from strong {
    color: #cf2333;
    font-size: 14px;
  }
  
  .htg-grid-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
    padding-bottom: 8px;
  }
  .htg-grid-wrapper::-webkit-scrollbar { height: 6px; }
  .htg-grid-wrapper::-webkit-scrollbar-track { background: transparent; }
  .htg-grid-wrapper::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
  .htg-grid {
    display: flex;
    gap: 14px;
    width: max-content;
    padding: 4px 2px;
  }
  .htg-card {
    width: 250px;
    flex-shrink: 0;
    scroll-snap-align: start;
  }
  @media (max-width: 480px) {
    .htg-card { width: 220px; }
  }
  
  .htg-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .htg-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    border-color: #cf2333;
  }
  
  .htg-card__image {
    position: relative;
    aspect-ratio: 1;
    background: #f8f9fb;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .htg-card__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 12px;
    transition: transform 0.3s;
  }
  .htg-card:hover .htg-card__image img {
    transform: scale(1.05);
  }
  
  .htg-card__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 4px;
    color: white;
  }
  
  .htg-card__body {
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }
  .htg-card__title {
    font-size: 14px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    line-height: 1.3;
  }
  .htg-card__subtitle {
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .htg-card__price {
    font-size: 18px;
    font-weight: 900;
    color: #0f172a;
    margin-top: auto;
    padding-top: 8px;
  }
  .htg-card__price small {
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
  }
  .htg-featured {
    display: grid;
    grid-template-columns: minmax(0,1.05fr) minmax(320px,.95fr);
    overflow: hidden;
    margin-bottom: 18px;
    border-radius: 16px;
    background: #13233f;
    color: white;
    text-decoration: none;
  }
  .htg-featured__image { min-height: 390px; background: #eef1f5; }
  .htg-featured__image img { width: 100%; height: 100%; object-fit: contain; transition: transform .35s ease; }
  .htg-featured:hover .htg-featured__image img { transform: scale(1.03); }
  .htg-featured__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(28px,4vw,48px); }
  .htg-featured__label { width: fit-content; margin-bottom: 19px; padding: 6px 10px; border-radius: 999px; background: #f2b705; color: #13233f; font-size: 10px; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
  .htg-featured h3 { margin: 0 0 12px; color: white; font-size: clamp(31px,4vw,48px); line-height: 1; letter-spacing: -.04em; }
  .htg-featured__copy p { margin: 0; color: #c7d0de; font-size: 14px; line-height: 1.6; }
  .htg-featured__facts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .htg-featured__facts span { padding: 7px 10px; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; color: white; font-size: 11px; font-weight: 750; }
  .htg-featured__price { margin-top: 24px; color: white; font-size: 18px; font-weight: 900; }
  .htg-featured__cta { margin-top: 10px; color: #f2b705; font-size: 13px; font-weight: 850; }
  @media (max-width: 760px) {
    .htg-featured { grid-template-columns: 1fr; }
    .htg-featured__image { min-height: 260px; }
  }
</style>

<div class="htg-section">

  {% assign all_products = collection.products %}

  {% comment %} ── Core Tier ── {% endcomment %}
  {% assign core_count = 0 %}
  {% for p in all_products %}
    {% assign h = p.handle | downcase %}
    {% if h contains 'cooling-cover' or h contains 'ergoalign' %}{% continue %}{% endif %}
    {% unless h contains 'luxe' or h contains 'elite' %}{% assign core_count = core_count | plus: 1 %}{% endunless %}
  {% endfor %}
  
  {% if core_count > 0 %}
  <div id="core-products" class="htg-tier">
    <div class="htg-tier__header">
      <h2 class="htg-tier__name">Core Collection</h2>
      <span class="htg-tier__count">{{ core_count }} models</span>
      <span class="htg-tier__price-from">From <strong>$799</strong></span>
    </div>
    <div class="htg-grid-wrapper"><div class="htg-grid">
      {% comment %} Midnight first (best seller) {% endcomment %}
      {% for p in all_products %}
        {% assign h = p.handle | downcase %}
        {% if h == 'helix-midnight' %}{% render 'helix-product-card', product: p %}{% endif %}
      {% endfor %}
      {% comment %} Rest of Core {% endcomment %}
      {% for p in all_products %}
        {% assign h = p.handle | downcase %}
        {% if h contains 'cooling-cover' or h contains 'ergoalign' %}{% continue %}{% endif %}
        {% if h == 'helix-midnight' %}{% continue %}{% endif %}
        {% unless h contains 'luxe' or h contains 'elite' %}
          {% render 'helix-product-card', product: p %}
        {% endunless %}
      {% endfor %}
    </div></div>
  </div>
  {% endif %}

  {% comment %} ── Luxe Tier ── {% endcomment %}
  {% assign luxe_count = 0 %}
  {% assign featured_luxe = blank %}
  {% for p in all_products %}
    {% assign h = p.handle | downcase %}
    {% if h == 'helix-midnight-luxe' %}{% assign featured_luxe = p %}{% endif %}
    {% if h contains 'cooling-cover' or h contains 'ergoalign' %}{% continue %}{% endif %}
    {% if h contains 'luxe' %}{% unless h contains 'elite' %}{% assign luxe_count = luxe_count | plus: 1 %}{% endunless %}{% endif %}
  {% endfor %}
  
  {% if luxe_count > 0 %}
  <div id="luxe-products" class="htg-tier">
    <div class="htg-tier__header">
      <h2 class="htg-tier__name">Luxe Collection</h2>
      <span class="htg-tier__count">{{ luxe_count }} models</span>
      <span class="htg-tier__price-from">From <strong>$1,149</strong></span>
    </div>
    {% if featured_luxe != blank %}
      <a href="{{ featured_luxe.url }}" class="htg-featured">
        <div class="htg-featured__image">
          {{ featured_luxe.featured_image | image_url: width: 1100 | image_tag: alt: 'Helix Midnight Luxe mattress', widths: '550, 800, 1100', sizes: '(max-width: 760px) 100vw, 55vw', loading: 'lazy' }}
        </div>
        <div class="htg-featured__copy">
          <span class="htg-featured__label">Balanced option</span>
          <h3>Helix Midnight Luxe</h3>
          <p>A medium-feel pillow top with zoned lumbar support. Start here if you want pressure relief without choosing an especially soft or firm mattress.</p>
          <div class="htg-featured__facts"><span>Medium feel</span><span>Side sleepers</span><span>Couples</span></div>
          <strong class="htg-featured__price">From {{ featured_luxe.price_min | money }}</strong>
          <span class="htg-featured__cta">View Midnight Luxe →</span>
        </div>
      </a>
    {% endif %}
    <div class="htg-grid-wrapper"><div class="htg-grid">
      {% comment %} Remaining Luxe feels; Midnight Luxe is featured above. {% endcomment %}
      {% for p in all_products %}
        {% assign h = p.handle | downcase %}
        {% if h == 'helix-midnight-luxe' %}{% continue %}{% endif %}
        {% if h contains 'cooling-cover' or h contains 'ergoalign' %}{% continue %}{% endif %}
        {% if h contains 'luxe' %}{% unless h contains 'elite' %}
          {% render 'helix-product-card', product: p %}
        {% endunless %}{% endif %}
      {% endfor %}
    </div></div>
  </div>
  {% endif %}

  {% comment %} ── Elite Tier ── {% endcomment %}
  {% assign elite_count = 0 %}
  {% for p in all_products %}
    {% assign h = p.handle | downcase %}
    {% if h contains 'cooling-cover' or h contains 'ergoalign' %}{% continue %}{% endif %}
    {% if h contains 'elite' %}{% assign elite_count = elite_count | plus: 1 %}{% endif %}
  {% endfor %}
  
  {% if elite_count > 0 %}
  <div id="elite-products" class="htg-tier">
    <div class="htg-tier__header">
      <h2 class="htg-tier__name">Elite Collection</h2>
      <span class="htg-tier__count">{{ elite_count }} models</span>
      <span class="htg-tier__price-from">From <strong>$1,874</strong></span>
    </div>
    <div class="htg-grid-wrapper"><div class="htg-grid">
      {% comment %} Midnight Elite first (best seller) {% endcomment %}
      {% for p in all_products %}
        {% assign h = p.handle | downcase %}
        {% if h == 'helix-midnight-elite' %}{% render 'helix-product-card', product: p %}{% endif %}
      {% endfor %}
      {% comment %} Rest of Elite {% endcomment %}
      {% for p in all_products %}
        {% assign h = p.handle | downcase %}
        {% if h == 'helix-midnight-elite' %}{% continue %}{% endif %}
        {% if h contains 'cooling-cover' or h contains 'ergoalign' %}{% continue %}{% endif %}
        {% if h contains 'elite' %}
          {% render 'helix-product-card', product: p %}
        {% endif %}
      {% endfor %}
    </div></div>
  </div>
  {% endif %}

</div>

{% schema %}
{
  "name": "Helix Tiered Grid",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": []
}
{% endschema %}
