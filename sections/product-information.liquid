

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

<style>
  /* PDP polish - variant picker, quantity, buy buttons */
  .variant-option--buttons .variant-option__button-label {
    min-width: 48px;
    padding: 10px 16px;
    font-weight: 700;
    font-size: 13px;
    border: 2px solid #d1d5db;
    border-radius: 8px;
    transition: all 0.15s ease;
    background: white;
  }
  .variant-option--buttons .variant-option__button-label:hover {
    border-color: #9ca3af;
    background: #f9fafb;
  }
  .variant-option--buttons input:checked + .variant-option__button-label {
    border-color: #1a1a2e;
    background: #1a1a2e;
    color: white;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  .quantity-selector {
    border: 2px solid #d1d5db;
    border-radius: 8px;
    overflow: hidden;
  }
  .quantity-selector button {
    min-width: 44px;
    min-height: 44px;
    font-size: 18px;
    font-weight: 700;
  }
  .quantity-selector input {
    font-size: 16px;
    font-weight: 700;
    min-height: 44px;
  }
  .buy-buttons-block .add-to-cart-button {
    border-radius: 8px;
    font-weight: 800;
    font-size: 15px;
    padding: 16px 24px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }
  .buy-buttons-block .add-to-cart-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
  }
  .shopify-payment-button__button {
    border-radius: 8px !important;
    font-weight: 800 !important;
    font-size: 15px !important;
    padding: 14px 24px !important;
    letter-spacing: 0.02em !important;
    text-transform: uppercase !important;
  }

  /* Discount Mattress brand colors - override primary button from black to navy */
  .button.add-to-cart-button,
  .shopify-payment-button__button--unbranded,
  .btn-primary,
  [data-type="add-to-cart"] .button {
    background-color: #162b49 !important;
    border-color: #162b49 !important;
  }
  .button.add-to-cart-button:hover,
  .shopify-payment-button__button--unbranded:hover {
    background-color: #1e3a5f !important;
    border-color: #1e3a5f !important;
  }
</style>

{% capture media_gallery %}
