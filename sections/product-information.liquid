

{% liquid
  assign product_title_downcase = closest.product.title | downcase
  assign is_helix_luxe = false
  assign is_bedgear_m3 = false
  if closest.product.vendor == 'Helix' and closest.product.type == 'Mattress' and product_title_downcase contains 'luxe'
    assign is_helix_luxe = true
  endif
  if closest.product.handle == 'bedgear-m3'
    assign is_bedgear_m3 = true
  endif
%}

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

<style>
  /* PDP polish - variant picker, quantity, buy buttons */
  .variant-option--buttons .variant-option__button-label {
    min-width: 48px;
    padding: 10px 16px;
    font-weight: 700;
    font-size: 13px;
    border: 2px solid #d1d5db;
    border-radius: 8px;
    transition: all 0.15s ease;
    background: white;
  }
  .variant-option--buttons .variant-option__button-label:hover {
    border-color: #9ca3af;
    background: #f9fafb;
  }
  .variant-option--buttons input:checked + .variant-option__button-label {
    border-color: #1a1a2e;
    background: #1a1a2e;
    color: white;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  .quantity-selector {
    border: 2px solid #d1d5db;
    border-radius: 8px;
    overflow: hidden;
  }
  .quantity-selector button {
    min-width: 44px;
    min-height: 44px;
    font-size: 18px;
    font-weight: 700;
  }
  .quantity-selector input {
    font-size: 16px;
    font-weight: 700;
    min-height: 44px;
  }
  .buy-buttons-block .add-to-cart-button {
    border-radius: 8px;
    font-weight: 800;
    font-size: 15px;
    padding: 16px 24px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }
  .buy-buttons-block .add-to-cart-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
  }
  .shopify-payment-button__button {
    border-radius: 8px !important;
    font-weight: 800 !important;
    font-size: 15px !important;
    padding: 14px 24px !important;
    letter-spacing: 0.02em !important;
    text-transform: uppercase !important;
  }

  /* Discount Mattress brand colors - override primary button from black to navy */
  .button.add-to-cart-button,
  .shopify-payment-button__button--unbranded,
  .btn-primary,
  [data-type="add-to-cart"] .button {
    background-color: #162b49 !important;
    border-color: #162b49 !important;
  }
  .button.add-to-cart-button:hover,
  .shopify-payment-button__button--unbranded:hover {
    background-color: #1e3a5f !important;
    border-color: #1e3a5f !important;
  }

  /* Trust signals & Financing */
  .pdp-trust-section { margin-top: 20px; padding-top: 16px; border-top: 1px solid #e5e7eb; max-width: 100%; overflow: hidden; }
  .pdp-trust-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 16px; }
  .pdp-trust-item { display: flex; align-items: center; gap: 8px; padding: 10px 12px; background: #f8fafc; border-radius: 8px; font-size: 12px; font-weight: 600; color: #334155; border: 1px solid #e2e8f0; }
  .pdp-trust-icon { display: grid; place-items: center; width: 18px; height: 18px; color: #162b49; flex-shrink: 0; }
  .pdp-trust-icon svg { display: block; width: 18px; height: 18px; }
  .pdp-trust-text { line-height: 1.3; }
  .pdp-trust-section--luxe { margin-top: 18px; padding-top: 0; border-top: 0; }
  .pdp-financing { position: relative; max-width: 100%; overflow: hidden; padding: 24px; border: 1px solid rgba(255,255,255,.12); border-radius: 16px; background: radial-gradient(circle at 92% 10%, rgba(72,127,190,.28), transparent 32%), linear-gradient(145deg, #0d2039 0%, #17385f 100%); box-shadow: 0 12px 28px rgba(15,34,59,.18); color: #fff; text-align: left; }
  .pdp-financing-copy,
  .pdp-financing-logos,
  .pdp-financing-btn,
  .pdp-financing-disclosure { position: relative; z-index: 1; }
  .pdp-financing-eyebrow { margin: 0 0 5px; color: #f4cc70; font-size: 10px; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .pdp-financing-heading { margin: 0; color: #fff; font-size: 21px; font-weight: 850; letter-spacing: -.02em; line-height: 1.15; }
  .pdp-financing-subhead { margin: 6px 0 0; color: #d9e5f2; font-size: 12px; line-height: 1.4; }
  .pdp-financing-logos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 18px 0 14px; }
  .pdp-financing-tile { display: flex; min-width: 0; min-height: 88px; flex-direction: column; align-items: center; justify-content: center; gap: 9px; overflow: hidden; padding: 12px 8px 9px; border: 1px solid rgba(255,255,255,.16); border-radius: 11px; background: #fff; box-shadow: 0 4px 12px rgba(2,13,27,.18); }
  .pdp-financing-tile img { display: block; width: auto; max-width: 92%; max-height: 31px; object-fit: contain; }
  .pdp-financing-tile span { color: #617086; font-size: 9px; font-weight: 750; line-height: 1.15; text-align: center; }
  .pdp-financing-tile--kafene { border-color: rgba(101,242,192,.35); background: #062d4e; }
  .pdp-financing-tile--kafene img { max-height: 32px; }
  .pdp-financing-tile--kafene span { color: #bcefdc; }
  .pdp-financing-tile--snap img { max-height: 34px; }
  .pdp-financing-btn { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; min-height: 46px; padding: 11px 18px; border-radius: 10px; background: #f4cc70; box-shadow: 0 4px 12px rgba(0,0,0,.15); color: #102744; font-size: 13px; font-weight: 850; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease, background .2s ease; }
  .pdp-financing-btn:hover { transform: translateY(-1px); background: #f8d887; box-shadow: 0 7px 16px rgba(0,0,0,.2); }
  .pdp-financing-btn span { font-size: 18px; line-height: 1; }
  .pdp-financing-disclosure { margin: 10px 0 0; color: #aebed0; font-size: 9px; line-height: 1.35; text-align: center; }

  /* Helix Luxe PDP purchase hierarchy */
  .product-information--helix-luxe {
    padding-top: 32px !important;
  }
  .product-information--helix-luxe .product-details > .group-block {
    --padding-block-start: 8px !important;
    --padding-block-end: 18px !important;
  }
  .product-information--helix-luxe .product-details > .group-block > .group-block-content {
    --gap: 18px !important;
  }
  .product-information--helix-luxe .product-details > .group-block > .group-block-content > rte-formatter:first-of-type p {
    margin: 0;
    color: #5b6d84;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .product-information--helix-luxe .product-details > .group-block > .group-block-content > .group-block .group-block-content {
    --gap: 8px !important;
  }
  .product-information--helix-luxe product-price {
    display: block;
    width: 100%;
    padding: 14px 16px !important;
    border: 1px solid #d4deea;
    border-left: 4px solid #162b49;
    border-radius: 12px;
    background: linear-gradient(135deg, #f3f7fc 0%, #fff 82%);
    box-shadow: 0 6px 18px rgba(22,43,73,.07);
  }
  .product-information--helix-luxe product-price .price__sale:not(.price__hidden) {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 10px;
  }
  .product-information--helix-luxe product-price .price__regular:not(.price__hidden) .price,
  .product-information--helix-luxe product-price .price__sale:not(.price__hidden) .price-item--sale {
    color: #102744;
    font-size: clamp(28px, 2.35vw, 36px);
    font-weight: 900;
    letter-spacing: -.035em;
    line-height: 1;
  }
  .product-information--helix-luxe product-price .compare-at-price {
    color: #607086;
    font-size: 16px;
    font-weight: 650;
    opacity: .62;
  }
  .product-information--helix-luxe .product-details > .group-block > .group-block-content > .divider {
    display: none;
  }
  .product-information--helix-luxe .variant-option > label {
    display: block;
    margin-bottom: 7px;
    color: #12233f;
    font-size: 13px;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .product-information--helix-luxe .variant-option__select-wrapper {
    min-height: 62px;
    border: 1.5px solid #b9c7d7;
    border-radius: 11px;
    background: #fff;
    box-shadow: 0 4px 14px rgba(22,43,73,.07);
  }
  .product-information--helix-luxe .variant-option__select {
    min-height: 62px;
    padding-block: 14px;
    color: #102744;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -.015em;
  }
  .product-information--helix-luxe .dm-luxe-assurance {
    margin-top: 0;
  }
  .product-information--helix-luxe .product-information__media .product-media-container:not(.dialog-zoomed-gallery *) {
    border: 1.5px solid #cbd6e2;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(22,43,73,.08);
  }
  @media (max-width: 749px) {
    .pdp-trust-section { margin-top: 12px; padding-top: 12px; }
    .pdp-trust-section--luxe { margin-top: 14px; padding-top: 0; }
    .pdp-trust-grid { gap: 6px; }
    .pdp-trust-item { padding: 10px 12px; font-size: 12px; gap: 6px; }
    .pdp-financing { padding: 20px 16px; border-radius: 14px; }
    .pdp-financing-heading { font-size: 20px; }
    .pdp-financing-logos { gap: 6px; margin-top: 16px; }
    .pdp-financing-tile { min-height: 82px; padding: 10px 6px 8px; }
    .pdp-financing-tile img { max-height: 27px; }
    .pdp-financing-tile--snap img { max-height: 30px; }
    .pdp-financing-btn { font-size: 12px; padding: 11px 14px; }
    .variant-option--buttons .variant-option__button-label { min-width: 40px; padding: 8px 12px; font-size: 12px; }
    .buy-buttons-block .add-to-cart-button { font-size: 13px; padding: 14px 16px; }
    .product-information--helix-luxe { padding-top: 22px !important; }
    .product-information--helix-luxe .product-details > .group-block > .group-block-content { --gap: 15px !important; }
    .product-information--helix-luxe product-price { padding: 13px 14px !important; }
    .product-information--helix-luxe product-price .price__regular:not(.price__hidden) .price,
    .product-information--helix-luxe product-price .price__sale:not(.price__hidden) .price-item--sale { font-size: 30px; }
    .product-information--helix-luxe .variant-option__select,
    .product-information--helix-luxe .variant-option__select-wrapper { min-height: 58px; }
    .product-information--helix-luxe .variant-option__select { font-size: 19px; }
    .product-information--helix-luxe .product-information__media .product-media-container:not(.dialog-zoomed-gallery *) {
      border-radius: 12px;
      box-shadow: 0 5px 16px rgba(22,43,73,.07);
    }
  }

  .dm-m3-product-media {
    position: sticky;
    top: var(--header-group-height, 0);
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #fff;
  }
  .dm-m3-product-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }
  @media (max-width: 749px) {
    .dm-m3-product-media { position: static; border-radius: 10px; }
  }
</style>

{% render 'product-breadcrumbs', product: closest.product %}

{% capture media_gallery %}
  {% if is_bedgear_m3 %}
    <div class="dm-m3-product-media">
      <img
        src="{{ 'bedgear-m3-mattress-official.jpg' | asset_url }}"
        alt="BEDGEAR M3 Performance Mattress"
        width="1000"
        height="1000"
        loading="eager"
        fetchpriority="high"
      >
    </div>
  {% else %}
    {%- content_for 'block',
      type: '_product-media-gallery',
      id: 'media-gallery',
      closest.product: closest.product
    -%}
  {% endif %}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    # Get the initial quantity based on quantity rules
    assign initial_quantity = current_variant.quantity_rule.min | default: 1
  %}

  <sticky-add-to-cart
    class="sticky-add-to-cart"
    data-variant-available="{{ current_variant.available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-initial-quantity="{{ initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar color-{{ settings.popover_color_scheme }}"
      data-stuck="false"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      {% liquid
        assign image_to_show = current_variant.featured_image | default: product.featured_image
      %}
      {% if is_bedgear_m3 %}
        <div class="sticky-add-to-cart__image">
          <img
            src="{{ 'bedgear-m3-mattress-official.jpg' | asset_url }}"
            alt="BEDGEAR M3 Performance Mattress"
            class="sticky-add-to-cart__image-img"
            width="120"
            height="120"
            loading="lazy"
            data-testid="sticky-product-image"
            ref="productImage"
          >
        </div>
      {% elsif image_to_show %}
        <div
          class="sticky-add-to-cart__image"
        >
          {% assign image_alt = image_to_show.alt | default: product.title | escape %}
          {{
            image_to_show
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              alt: image_alt,
              class: 'sticky-add-to-cart__image-img',
              data-testid: 'sticky-product-image',
              srcset: null,
              sizes: null,
              ref: 'productImage'
          }}
        </div>
      {% endif %}

      {% liquid
        assign has_single_option = false
        if product.has_only_default_variant != true and product.options.size == 1
          assign has_single_option = true
        endif

        if image_to_show == blank
          assign has_image = false
        else
          assign has_image = true
        endif
      %}
      <div
        class="sticky-add-to-cart__info"
        data-has-image="{{ has_image }}"
        data-singleton="{{ product.has_only_default_variant }}"
        data-single-option="{{ has_single_option }}"
      >
        <p
          class="sticky-add-to-cart__title"
          data-testid="sticky-product-title"
        >
          {{ product.title | escape }}
        </p>
        <div
          class="sticky-add-to-cart__variant"
          data-testid="sticky-variant-title"
          {% if product.has_only_default_variant %}
            style="display: none;"
          {% endif %}
        >
          {% unless product.has_only_default_variant %}
            {% if current_variant != blank %}
              {% assign variant_title = current_variant.title | escape %}
            {% endif %}
            {{ variant_title }}
          {% endunless %}
        </div>
      </div>

      <div
        class="sticky-add-to-cart__price"
        data-testid="sticky-price-display"
      >
        {% render 'price', product_resource: product, show_sale_price_first: true %}
      </div>

      <button
        type="button"
        class="sticky-add-to-cart__button add-to-cart-button button"
        ref="addToCartButton"
        on:click="/handleAddToCartClick"
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        <span
          class="add-to-cart-text"
        >
          {% if current_variant.available %}
            <span class="svg-wrapper add-to-cart-icon">
              {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
            </span>
          {% endif %}
          <span class="add-to-cart-text__content">
            <span>
              {%- if current_variant.available -%}
                {{- 'products.product.add_to_cart' | t -}}
              {%- elsif current_variant == blank -%}
                {{- 'products.product.unavailable' | t -}}
              {%- else -%}
                {{- 'products.product.sold_out' | t -}}
              {%- endif -%}
            </span>
            <span
              ref="quantityDisplay"
              {% if current_variant.available and initial_quantity > 1 %}
                style="display: inline;"
              {% else %}
                style="display: none;"
              {% endif %}
            >
              {{- ' (' -}}
              <span ref="quantityNumber">{{- initial_quantity -}}</span>
              {{- ')' -}}
            </span>
          </span>
        </span>
        <span class="add-to-cart__added">
          <span class="svg-wrapper add-to-cart__added-icon">
            {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>
    </div>
  </sticky-add-to-cart>
{% endif %}



{% liquid
  assign product_media_size = closest.product.media.size
  if is_bedgear_m3
    assign product_media_size = 1
  endif
%}

{% render 'product-information-content',
  product_media_size: product_media_size,
  section_id: section.id,
  settings: section.settings,
  is_helix_luxe: is_helix_luxe,
  media_gallery: media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks
%}

{% stylesheet %}
  .sticky-add-to-cart__bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    z-index: calc(var(--layer-sticky) - 1); /* Below sticky header */
    display: block;
    width: 600px;
    border-radius: calc(
      var(--style-border-radius-buttons-primary) + min(var(--padding-sm), var(--style-border-radius-buttons-primary))
    );
    box-shadow: var(--shadow-popover);
    padding: var(--padding-sm);
    /* Layout styling */
    display: flex;
    align-items: center;
    gap: var(--gap-md);

    @starting-style {
      opacity: 0;
      transform: translateX(-50%) translateY(calc(100% + 40px));
    }

    &::before {
      --border: 2px;
      content: '';
      position: absolute;
      inset: calc(var(--border) * -1);
      background: linear-gradient(var(--color-background) 0 100%), linear-gradient(hsl(0 0% 0% / 0.15) 0 100%);
      background-clip: content-box, border-box;
      border: var(--border) solid #0000;
      border-radius: inherit;
      z-index: -1;
      backdrop-filter: blur(20px) saturate(180%) brightness(1.5);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticky-add-to-cart__bar {
      transition-property: transform, opacity, display;
      transition-duration: 0.3s;
      transition-timing-function: var(--ease-out-quad);
      transition-behavior: allow-discrete;
    }
  }

  .sticky-add-to-cart__bar[data-stuck='true'] {
    transform: translateX(-50%) translateY(0%);
    opacity: 1;
  }

  sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__bar {
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    display: none;
  }

  .sticky-add-to-cart__info[data-has-image='false'] {
    padding-left: var(--padding-lg);
  }

  .sticky-add-to-cart__image {
    flex-shrink: 0;
    aspect-ratio: 1;
    height: var(--height-buy-buttons);
    overflow: hidden;
    border-radius: var(--style-border-radius-buttons-primary);
    background: var(--color-background-secondary);
  }

  .sticky-add-to-cart__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sticky-add-to-cart__info {
    flex: 1;
    min-width: 0; /* Allow text truncation */
  }

  .sticky-add-to-cart__title {
    font-size: var(--font-paragraph-medium--size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-paragraph--line-height);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sticky-add-to-cart__variant {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-paragraph-small--size);
    margin-top: var(--margin-3xs);
  }

  .sticky-add-to-cart__price {
    font-weight: var(--font-weight-semibold);
  }

  .sticky-add-to-cart__button {
    height: var(--height-buy-buttons);
    position: relative;
  }

  /* Mobile adjustments */
  @media screen and (max-width: 749px) {
    .sticky-add-to-cart__bar {
      bottom: 0;
      width: 100%;
      max-width: none;
      border-radius: 0;

      &::before {
        --border: 1px;
      }
    }

    .sticky-add-to-cart__bar .add-to-cart-text__content {
      display: none;
    }

    .sticky-add-to-cart__info[data-has-image='false'] {
      padding-left: 0;
    }

    .sticky-add-to-cart__title {
      font-size: var(--font-paragraph--size);
    }

    .sticky-add-to-cart__button {
      padding: var(--padding-lg);
    }

    .sticky-add-to-cart__price {
      font-size: var(--font-paragraph-small--size);
    }

    .sticky-add-to-cart__button {
      width: var(--height-buy-buttons);
    }

    sticky-add-to-cart:not([data-variant-available='true']) .add-to-cart-text__content {
      display: initial;
    }

    sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__button {
      width: auto;
    }
  }

  /* Small mobile - hide text content and compare price */
  @media screen and (max-width: 389px) {
    .sticky-add-to-cart__bar {
      .compare-at-price {
        display: none;
      }
    }

    .sticky-add-to-cart__title {
      display: none;
    }

    /* For product with only default variant show title */
    .sticky-add-to-cart__info[data-singleton='true'] .sticky-add-to-cart__title {
      display: block;
    }

    /* For single variant show title and variant, truncate both. variant should be identifiable with truncation */
    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__title {
      display: block;
    }

    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__variant {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
