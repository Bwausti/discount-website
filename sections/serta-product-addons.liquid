{% comment %}
  serta-product-addons.liquid
  Shows Serta Cascade + iComfort comparison on product pages
  Only renders on Serta products
{% endcomment %}

{% assign is_serta_product = false %}
{% if closest.product.vendor == "Serta" %}
  {% assign is_serta_product = true %}
  {% assign title_lower = closest.product.title | downcase %}
  {% assign is_cascade_canyon = false %}
  {% assign is_cascade_range = false %}
  {% assign is_cascade_ridge = false %}
  {% assign is_icomfort = false %}
  {% if title_lower contains "cascade canyon" %}
    {% assign is_cascade_canyon = true %}
  {% elsif title_lower contains "cascade range" %}
    {% assign is_cascade_range = true %}
  {% elsif title_lower contains "cascade ridge" %}
    {% assign is_cascade_ridge = true %}
  {% elsif title_lower contains "icomfort" %}
    {% assign is_icomfort = true %}
  {% endif %}
{% endif %}

{% if is_serta_product %}

<style>
  .serta-addons {
    background: #f3f0f0;
    border-top: 1px solid #e2e8f0;
    padding: 48px 24px;
    margin-top: 0;
  }
  .serta-addons__inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .serta-addons__header {
    margin-bottom: 32px;
  }
  .serta-addons__label {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #b22222;
    margin-bottom: 8px;
  }
  .serta-addons__title {
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 900;
    color: #2d2828;
    letter-spacing: -0.02em;
    margin: 0 0 8px 0;
  }
  .serta-addons__sub {
    font-size: 14px;
    color: #64748b;
    margin: 0;
  }

  .serta-section-label {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: #b22222;
    margin: 32px 0 16px 0;
  }
  .serta-section-label:first-of-type {
    margin-top: 0;
  }

  .serta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }
  .serta-card {
    background: white;
    border: 2px solid transparent;
    border-radius: 10px;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    position: relative;
  }
  .serta-card:hover {
    border-color: #b22222;
    box-shadow: 0 6px 24px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }
  .serta-card.active {
    border-color: #b22222;
    background: #fdf2f2;
  }
  .serta-card.active::after {
    content: 'Current';
    position: absolute;
    top: -8px;
    right: 12px;
    background: #b22222;
    color: white;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 10px;
    border-radius: 4px;
  }
  .serta-card__series {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #b22222;
  }
  .serta-card__name {
    font-size: 15px;
    font-weight: 800;
    color: #2d2828;
    margin: 0;
  }
  .serta-card__firmness {
    font-size: 10px;
    font-weight: 600;
    color: #64748b;
    background: #f3f0f0;
    padding: 2px 8px;
    border-radius: 4px;
    width: fit-content;
  }
  .serta-card__desc {
    font-size: 13px;
    color: #64748b;
    line-height: 1.5;
    margin: 0;
    flex-grow: 1;
  }
  .serta-card__price {
    font-size: 14px;
    font-weight: 700;
    color: #2d2828;
    margin: 0;
  }
  .serta-card__cta {
    font-size: 12px;
    font-weight: 800;
    color: #b22222;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
  }
  .serta-card:hover .serta-card__cta { gap: 8px; }
</style>

<div class="serta-addons">
  <div class="serta-addons__inner">
    <div class="serta-addons__header">
      <p class="serta-addons__label">Serta Collections</p>
      <h2 class="serta-addons__title">America's mattress leader</h2>
      <p class="serta-addons__sub">From everyday value to advanced cooling — explore Serta's Cascade and iComfort lines</p>
    </div>

    <!-- Cascade Series -->
    <p class="serta-section-label">Cascade Collection</p>
    <div class="serta-grid">

      {% if is_cascade_ridge %}
        <div class="serta-card active">
          <p class="serta-card__series">Cascade</p>
          <h3 class="serta-card__name">Cascade Ridge Plush</h3>
          <span class="serta-card__firmness">Plush</span>
          <p class="serta-card__desc">A plush comfort mattress with quilted pillow top construction. Great value for guest rooms or budget-conscious shoppers.</p>
          <p class="serta-card__price">$325</p>
          <p class="serta-card__cta">You're viewing →</p>
        </div>
      {% else %}
        <a href="/products/serta-cascade-ridge-plush" class="serta-card">
          <p class="serta-card__series">Cascade</p>
          <h3 class="serta-card__name">Cascade Ridge Plush</h3>
          <span class="serta-card__firmness">Plush</span>
          <p class="serta-card__desc">A plush comfort mattress with quilted pillow top construction. Great value for guest rooms or budget-conscious shoppers.</p>
          <p class="serta-card__price">$325</p>
          <p class="serta-card__cta">View →</p>
        </a>
      {% endif %}

      {% if is_cascade_canyon and title_lower contains "firm" %}
        <div class="serta-card active">
          <p class="serta-card__series">Cascade</p>
          <h3 class="serta-card__name">Cascade Canyon Firm</h3>
          <span class="serta-card__firmness">Firm</span>
          <p class="serta-card__desc">A firm support mattress for back and stomach sleepers. Durable construction at a competitive price point.</p>
          <p class="serta-card__price">$375</p>
          <p class="serta-card__cta">You're viewing →</p>
        </div>
      {% else %}
        <a href="/products/serta-cascade-canyon-firm" class="serta-card">
          <p class="serta-card__series">Cascade</p>
          <h3 class="serta-card__name">Cascade Canyon Firm</h3>
          <span class="serta-card__firmness">Firm</span>
          <p class="serta-card__desc">A firm support mattress for back and stomach sleepers. Durable construction at a competitive price point.</p>
          <p class="serta-card__price">$375</p>
          <p class="serta-card__cta">View →</p>
        </a>
      {% endif %}

      {% if is_cascade_canyon and title_lower contains "medium" %}
        <div class="serta-card active">
          <p class="serta-card__series">Cascade</p>
          <h3 class="serta-card__name">Cascade Canyon Medium</h3>
          <span class="serta-card__firmness">Medium</span>
          <p class="serta-card__desc">A medium-feel mattress that balances support and comfort. Ideal for combination sleepers.</p>
          <p class="serta-card__price">$375</p>
          <p class="serta-card__cta">You're viewing →</p>
        </div>
      {% else %}
        <a href="/products/serta-cascade-canyon-medium" class="serta-card">
          <p class="serta-card__series">Cascade</p>
          <h3 class="serta-card__name">Cascade Canyon Medium</h3>
          <span class="serta-card__firmness">Medium</span>
          <p class="serta-card__desc">A medium-feel mattress that balances support and comfort. Ideal for combination sleepers.</p>
          <p class="serta-card__price">$375</p>
          <p class="serta-card__cta">View →</p>
        </a>
      {% endif %}

      {% if is_cascade_range %}
        <div class="serta-card active">
          <p class="serta-card__series">Cascade</p>
          <h3 class="serta-card__name">Cascade Range Plush Pillow Top</h3>
          <span class="serta-card__firmness">Plush Pillow Top</span>
          <p class="serta-card__desc">Enhanced plush comfort with a thick pillow top layer. Extra cushioning for pressure relief.</p>
          <p class="serta-card__price">$599</p>
          <p class="serta-card__cta">You're viewing →</p>
        </div>
      {% else %}
        <a href="/products/serta-cascade-range-plush-pillow-top" class="serta-card">
          <p class="serta-card__series">Cascade</p>
          <h3 class="serta-card__name">Cascade Range Plush Pillow Top</h3>
          <span class="serta-card__firmness">Plush Pillow Top</span>
          <p class="serta-card__desc">Enhanced plush comfort with a thick pillow top layer. Extra cushioning for pressure relief.</p>
          <p class="serta-card__price">$599</p>
          <p class="serta-card__cta">View →</p>
        </a>
      {% endif %}

    </div>

    <!-- iComfort Series -->
    <p class="serta-section-label">iComfort Collection</p>
    <div class="serta-grid">

      {% if is_icomfort and title_lower contains "pro" %}
        <div class="serta-card active">
          <p class="serta-card__series">iComfort</p>
          <h3 class="serta-card__name">iComfortPro</h3>
          <span class="serta-card__firmness">Premium</span>
          <p class="serta-card__desc">Advanced cooling foam technology with enhanced support layers. Serta's premium temperature-regulating mattress.</p>
          <p class="serta-card__price">$799</p>
          <p class="serta-card__cta">You're viewing →</p>
        </div>
      {% else %}
        <a href="/products/serta-icomfortpro-mattress" class="serta-card">
          <p class="serta-card__series">iComfort</p>
          <h3 class="serta-card__name">iComfortPro</h3>
          <span class="serta-card__firmness">Premium</span>
          <p class="serta-card__desc">Advanced cooling foam technology with enhanced support layers. Serta's premium temperature-regulating mattress.</p>
          <p class="serta-card__price">$799</p>
          <p class="serta-card__cta">View iComfortPro →</p>
        </a>
      {% endif %}

      {% if is_icomfort %}
        {% if title_lower contains "pro" %}
          {% comment %}Pro variant — handled above{% endcomment %}
        {% else %}
          <div class="serta-card active">
            <p class="serta-card__series">iComfort</p>
            <h3 class="serta-card__name">iComfort</h3>
            <span class="serta-card__firmness">Standard</span>
            <p class="serta-card__desc">Serta's cooling foam technology at an accessible price. Temperature regulation with supportive comfort.</p>
            <p class="serta-card__price">$550</p>
            <p class="serta-card__cta">You're viewing →</p>
          </div>
        {% endif %}
      {% else %}
        <a href="/products/serta-icomfort-mattress" class="serta-card">
          <p class="serta-card__series">iComfort</p>
          <h3 class="serta-card__name">iComfort</h3>
          <span class="serta-card__firmness">Standard</span>
          <p class="serta-card__desc">Serta's cooling foam technology at an accessible price. Temperature regulation with supportive comfort.</p>
          <p class="serta-card__price">$550</p>
          <p class="serta-card__cta">View iComfort →</p>
        </a>
      {% endif %}

    </div>
  </div>
</div>

{% endif %}

{% schema %}
{
  "name": "Serta Product Add-ons",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": []
}
{% endschema %}