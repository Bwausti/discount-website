<!-- Section: trust_signals -->
{%- comment -%}
  Live-text trust strip — replaces image banner with editable, accessible text.
  Shown on homepage between hero and brand logos.
{%- endcomment -%}

{%- if section.settings.enable_section -%}
<section
  class="trust-signals"
  aria-label="Trust signals"
  style="
    background: {{ section.settings.background_color }};
    border-top: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-bottom: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
  "
>
  <div class="trust-signals__inner page-width-content">
    <ul class="trust-signals__list" role="list">

      {%- for i in (1..6) -%}
        {%- assign item_text_key = 'item_' | append: i | append: '_text' -%}
        {%- assign item_url_key = 'item_' | append: i | append: '_url' -%}
        {%- assign item_label_key = 'item_' | append: i | append: '_label' -%}

        {%- assign item_text = section.settings[item_text_key] | strip -%}

        {%- if item_text != blank -%}
          {%- assign item_url = section.settings[item_url_key] -%}
          {%- assign item_label = section.settings[item_label_key] -%}

          <li class="trust-signals__item{% if forloop.last %} trust-signals__item--last{% endif %}">

            {%- if item_url != blank -%}
              <a
                href="{{ item_url }}"
                class="trust-signals__link"
                {% if item_label != blank %}aria-label="{{ item_label }}"{% endif %}
                {% if item_url contains 'google' or item_url contains 'maps' %}target="_blank" rel="noopener"{% endif %}
              >
                <span class="trust-signals__check" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect width="14" height="14" rx="2" fill="#16a34a" opacity="0.12"/>
                    <path d="M3.5 7L6 9.5L10.5 5" stroke="#16a34a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                {{- item_text -}}
              </a>
            {%- else -%}
              <span class="trust-signals__plain">
                <span class="trust-signals__check" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <rect width="14" height="14" rx="2" fill="#16a34a" opacity="0.12"/>
                    <path d="M3.5 7L6 9.5L10.5 5" stroke="#16a34a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                {{- item_text -}}
              </span>
            {%- endif -%}

          </li>
        {%- endif -%}
      {%- endfor -%}

    </ul>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.trust-signals {
  padding: 14px 0;
}
.trust-signals__inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
}
.trust-signals__list {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0;
  list-style: none;
  margin: 0;
  padding: 0;
}
.trust-signals__item {
  display: flex;
  align-items: center;
}
.trust-signals__item:not(.trust-signals__item--last)::after {
  content: "·";
  display: inline-block;
  margin: 0 12px;
  color: #cbd5e1;
  font-size: 18px;
  font-weight: 300;
  line-height: 1;
  flex-shrink: 0;
}
.trust-signals__check {
  display: inline-flex;
  align-items: center;
  color: #16a34a;
  margin-right: 5px;
  flex-shrink: 0;
}
.trust-signals__plain,
.trust-signals__link {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-body, 'Inter', 'Segoe UI', sans-serif);
  font-size: 13px;
  font-weight: 600;
  color: #1e293b;
  text-decoration: none;
  white-space: nowrap;
  line-height: 1;
}
a.trust-signals__link:hover {
  color: #cf2333;
  text-decoration: underline;
}

/* Mobile */
@media screen and (max-width: 768px) {
  .trust-signals__inner {
    padding: 0 16px;
  }
  .trust-signals__list {
    flex-direction: column;
    gap: 8px;
  }
  .trust-signals__item:not(.trust-signals__item--last)::after {
    display: none;
  }
  .trust-signals__plain,
  .trust-signals__link {
    font-size: 12px;
    white-space: normal;
  }
}
{% endstylesheet %}

{% schema %}
